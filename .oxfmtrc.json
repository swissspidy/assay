{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "test-results/**",
    "playwright-report/**",
    "package-lock.json",
    "examples/*/stress/**",
    "eval/results/**",
    "stability/results/**",
    "eval/cassettes/**",
    "examples/*/compiled/**"
  ]
}
