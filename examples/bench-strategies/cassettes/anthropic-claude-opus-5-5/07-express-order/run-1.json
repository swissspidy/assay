  "sha256:eeccc02f5e86edf697b88bbb9ec7f33b09fad65b8c2027dab6d6ad45b98d836b": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01ByDA6YNrTYmycCriH9Fryy",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "order-created-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded (2xx), creating an order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "order-placed-probe",
        "requirement": "R1",
        "description": "The backend's latest order has status 'placed'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
         },
         "expect": {
          "equals": "placed"
         }
        }
       },
       {
        "id": "order-express",
        "requirement": "R2",
        "description": "The latest order stored by the backend uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "confirmation-url",
        "requirement": "R3",
        "description": "The page URL is the confirmation page of the latest order (/orders/<id>).",
        "assert": {
         "kind": "value",
         "source": {
          "from": "url",
          "part": "pathname"
         },
         "normalize": [
          {
           "op": "extract",
           "regex": "^/orders/([^/]+)/?$",
           "group": 1
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       },
       {
        "id": "confirmation-heading",
        "requirement": "R3",
        "description": "The main area shows an 'Order confirmed' heading.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "main"
         },
         "match": {
          "role": "heading",
          "name": {
           "contains": "Order confirmed",
           "ignoreCase": true
          }
         }
        }
       },
       {
        "id": "confirmation-order-number",
        "requirement": "R3",
        "description": "The order summary shows the order number of the latest order.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "text",
          "scope": {
           "role": "region",
           "name": "Order summary"
          },
          "pattern": "Order number:\\s*([A-Za-z0-9-]+)",
          "group": 1
         },
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       },
       {
        "id": "order-items-match-cart",
        "requirement": "R4",
        "description": "The latest order's items are exactly the items that were in the cart before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items"
            }
           ]
          }
         }
        }
       },
       {
        "id": "order-name",
        "requirement": "R5",
        "description": "The latest order is in the name of Ada Lovelace.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
         },
         "normalize": [
          "trim"
         ],
         "expect": {
          "equals": "Ada Lovelace"
         }
        }
       }
      ]
     }
    }
   ],
