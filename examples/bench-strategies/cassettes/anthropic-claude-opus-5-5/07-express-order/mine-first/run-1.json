            },
            "pattern": "Order number:\\s*([A-Za-z0-9-]+)",
            "group": 1
           },
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
             }
            }
           }
          }
         ]
        }
       },
       {
        "id": "R5-order-items-match-cart",
        "requirement": "R5",
        "description": "The latest order's items equal the cart's items before the task, compared as whole records.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
