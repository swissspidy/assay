       },
       "expect": {
        "schema": {
         "type": "array",
         "contains": {
          "type": "object",
          "required": [
           "sku",
           "qty"
          ],
          "properties": {
           "sku": {
            "const": "MUG-BLUE"
           },
           "qty": {
            "const": 3
           }
          }
         }
        }
       }
      }
     }
    },
    {
     "id": "toolu_01Abyr5F2JNzoVfRV7NPd3an",
     "name": "try_assertion",
     "input": {
      "assert": {
       "kind": "each",
       "scope": {
        "role": "table",
        "name": "Cart"
       },
       "match": {
        "role": "row",
        "name": {
         "contains": "Blue Mug"
        }
       },
       "count": {
        "eq": 1
       },
       "assert": {
        "kind": "state",
        "target": {
         "role": "spinbutton",
         "name": {
          "contains": "Blue Mug"
         }
        },
        "expect": {
         "value": {
          "regex": "^\\s*3\\s*$"
         }
        }
       }
      }
     }
    }
