{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/01-newsletter",
  "version": "1",
  "task": {
    "instruction": "Subscribe me to the Tiny Shop newsletter.",
    "outcomes": "Then the newsletter subscription is saved\nThen the newsletter checkbox in the preferences is checked"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The newsletter subscription is saved.",
      "source": {
        "field": "outcomes",
        "quote": "the newsletter subscription is saved"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The newsletter checkbox in the preferences is checked.",
      "source": {
        "field": "outcomes",
        "quote": "the newsletter checkbox in the preferences is checked"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-probe-newsletter",
      "requirement": "R1",
      "description": "The backend settings probe shows newsletter set to true.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "settings",
          "pointer": "/newsletter"
        },
        "expect": {
          "equals": true
        }
      }
    },
    {
      "id": "r1-put-request",
      "requirement": "R1",
      "description": "A successful PUT to /api/settings sent newsletter: true.",
      "assert": {
        "kind": "request",
        "match": {
          "method": [
            "PUT",
            "POST",
            "PATCH"
          ],
          "url": {
            "path": "/api/settings"
          },
          "status": {
            "gte": 200,
            "lt": 300
          },
          "requestBody": {
            "type": "object",
            "required": [
              "newsletter"
            ],
            "properties": {
              "newsletter": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "id": "r2-checkbox-checked",
      "requirement": "R2",
      "description": "The newsletter checkbox in the Preferences form is checked.",
      "assert": {
        "kind": "state",
        "target": {
          "anchors": [
            {
              "role": "checkbox",
              "name": {
                "contains": "newsletter",
                "ignoreCase": true
              },
              "landmark": {
                "role": "form",
                "name": {
                  "contains": "Preferences"
                }
              }
            },
            {
              "role": "checkbox",
              "name": {
                "contains": "newsletter",
                "ignoreCase": true
              },
              "within": {
                "role": "form",
                "name": {
                  "contains": "Preferences"
                }
              }
            }
          ]
        },
        "expect": {
          "checked": true
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T06:55:37.007Z"
  }
}
