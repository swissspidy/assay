{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/10-dark-german",
  "version": "1",
  "task": {
    "instruction": "Switch Tiny Shop to the dark theme and to German.",
    "outcomes": "Then the theme preference is dark\nThen the language preference is German"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "Tiny Shop's theme preference is set to dark.",
      "source": {
        "field": "outcomes",
        "quote": "the theme preference is dark"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "Tiny Shop's language preference is set to German.",
      "source": {
        "field": "outcomes",
        "quote": "the language preference is German"
      }
    }
  ],
  "checks": [
    {
      "id": "theme-dark",
      "requirement": "R1",
      "description": "localStorage key 'theme' on the Tiny Shop origin is 'dark'.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "storage",
          "area": "local",
          "key": "theme",
          "origin": "http://localhost:4173"
        },
        "normalize": [
          "trim",
          "lowercase"
        ],
        "expect": {
          "equals": "dark"
        }
      }
    },
    {
      "id": "lang-german",
      "requirement": "R2",
      "description": "The 'lang' cookie is set to German ('de').",
      "assert": {
        "kind": "value",
        "source": {
          "from": "storage",
          "area": "cookie",
          "key": "lang"
        },
        "normalize": [
          "trim",
          "lowercase"
        ],
        "expect": {
          "regex": "^de([-_][a-z]+)?$"
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T10:44:11.900Z"
  }
}
