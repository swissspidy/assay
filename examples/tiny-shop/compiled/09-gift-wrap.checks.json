      "description": "The backend's latest order exists with status 'placed'.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder"
        },
        "expect": {
          "schema": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "placed"
              }
            }
          }
        }
      }
    },
    {
      "id": "order-gift-wrapped",
