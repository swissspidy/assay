  "id": "tiny-shop/09-gift-wrap",
  "version": "1",
  "task": {
    "instruction": "Check out my cart as a gift: it must be gift wrapped.",
    "outcomes": "Then the order is gift wrapped"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The order is gift wrapped.",
