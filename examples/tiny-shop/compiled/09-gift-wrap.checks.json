{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/09-gift-wrap",
  "version": "1",
  "task": {
    "instruction": "Check out my cart as a gift: it must be gift wrapped.",
    "outcomes": "Then the order is gift wrapped"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The order is gift wrapped.",
      "source": {
        "field": "outcomes",
        "quote": "the order is gift wrapped"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The user's cart is checked out, so an order is placed.",
      "source": {
        "field": "instruction",
        "quote": "Check out my cart"
      }
    }
  ],
  "checks": [
    {
      "id": "order-placed-request",
      "requirement": "R2",
      "description": "A POST to /api/orders succeeded and returned a placed order.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          },
          "responseBody": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "status": {
                "const": "placed"
              }
            }
          }
        }
      }
    },
    {
      "id": "order-placed-probe",
      "requirement": "R2",
      "description": "The backend's latest order exists with status placed.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
        },
        "expect": {
          "equals": "placed"
        }
      }
    },
    {
      "id": "order-giftwrap-probe",
      "requirement": "R1",
      "description": "The backend's latest placed order has gift wrap enabled.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder"
        },
        "expect": {
          "schema": {
            "type": "object",
            "required": [
              "status",
              "giftWrap"
            ],
            "properties": {
              "status": {
                "const": "placed"
              },
              "giftWrap": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "id": "order-giftwrap-request",
      "requirement": "R1",
      "description": "The last order creation request asked for gift wrapping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "request",
          "match": {
            "method": "POST",
            "url": {
              "path": "/api/orders"
            },
            "status": {
              "gte": 200,
              "lt": 300
            }
          },
          "pick": "last",
          "pointer": "/giftWrap"
        },
        "expect": {
          "equals": true
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T06:57:38.269Z"
  }
}
