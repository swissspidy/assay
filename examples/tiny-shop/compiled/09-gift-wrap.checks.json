{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/09-gift-wrap",
  "version": "1",
  "task": {
    "instruction": "Check out my cart as a gift: it must be gift wrapped.",
    "outcomes": "Then the order is gift wrapped"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The order has gift wrapping.",
      "source": {
        "field": "outcomes",
        "quote": "the order is gift wrapped"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The user's cart is checked out, so an order is placed.",
      "source": {
        "field": "instruction",
        "quote": "Check out my cart"
      }
    }
  ],
  "checks": [
    {
      "id": "order-placed-request",
      "requirement": "R2",
      "description": "A POST to /api/orders succeeded with a 2xx status, placing an order.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        },
        "count": {
          "gte": 1
        }
      }
    },
    {
      "id": "order-placed-probe",
      "requirement": "R2",
      "description": "The backend's latest order has status 'placed' and is the order created by the checkout request.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "value",
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/status"
            },
            "expect": {
              "equals": "placed"
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
            },
            "expect": {
              "sameAs": {
                "source": {
                  "from": "response",
                  "match": {
                    "method": "POST",
                    "url": {
                      "path": "/api/orders"
                    },
                    "status": {
                      "gte": 200,
                      "lt": 300
                    }
                  },
                  "pick": "last",
                  "pointer": "/id"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "order-gift-wrapped",
      "requirement": "R1",
      "description": "The backend's latest order has giftWrap set to true.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/giftWrap"
        },
        "expect": {
          "equals": true
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T10:43:55.544Z"
  }
}
