{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/09-gift-wrap",
  "version": "1",
  "task": {
    "instruction": "Check out my cart as a gift: it must be gift wrapped.",
    "outcomes": "Then the order is gift wrapped"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The order is gift wrapped.",
      "source": {
        "field": "outcomes",
        "quote": "the order is gift wrapped"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The cart is checked out, so an order is placed.",
      "source": {
        "field": "instruction",
        "quote": "Check out my cart"
      }
    }
  ],
  "checks": [
    {
      "id": "order-placed-request",
      "requirement": "R2",
      "description": "A POST to /api/orders succeeded (2xx), placing an order.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        }
      }
    },
    {
      "id": "order-placed-probe",
      "requirement": "R2",
      "description": "The backend's latest order has status 'placed'.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
        },
        "expect": {
          "equals": "placed"
        }
      }
    },
    {
      "id": "giftwrap-probe",
      "requirement": "R1",
      "description": "The backend's latest order has giftWrap set to true.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/giftWrap"
        },
        "expect": {
          "equals": true
        }
      }
    },
    {
      "id": "giftwrap-request",
      "requirement": "R1",
      "description": "The last successful order POST sent giftWrap true.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "request",
          "match": {
            "method": "POST",
            "url": {
              "path": "/api/orders"
            },
            "status": {
              "gte": 200,
              "lt": 300
            }
          },
          "pick": "last",
          "pointer": "/giftWrap"
        },
        "expect": {
          "equals": true
        }
      }
    }
  ],
