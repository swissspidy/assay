  "sha256:376f9a9f8be066b9d735b6445abd1bdab21c973a6e9b2f82b9d656ab2d7b6c9f": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_014L7WDMjbZdHqUw9C18V6DV",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "order-placed-request",
        "requirement": "R2",
        "description": "A POST to /api/orders succeeded and returned a placed order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          },
          "responseBody": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "order-placed-probe",
        "requirement": "R2",
        "description": "The backend's latest order exists with status placed.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
         },
         "expect": {
          "equals": "placed"
         }
        }
       },
       {
        "id": "order-giftwrap-probe",
        "requirement": "R1",
        "description": "The backend's latest placed order has gift wrap enabled.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "status",
            "giftWrap"
           ],
           "properties": {
            "status": {
             "const": "placed"
            },
            "giftWrap": {
             "const": true
            }
           }
          }
         }
        }
       },
       {
        "id": "order-giftwrap-request",
        "requirement": "R1",
        "description": "The last order creation request asked for gift wrapping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "request",
          "match": {
           "method": "POST",
           "url": {
            "path": "/api/orders"
           },
           "status": {
            "gte": 200,
            "lt": 300
           }
          },
          "pick": "last",
          "pointer": "/giftWrap"
         },
         "expect": {
          "equals": true
         }
        }
       }
      ]
     }
    }
   ],
