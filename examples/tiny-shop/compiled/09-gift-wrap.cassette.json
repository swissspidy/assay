  "sha256:24441df89de09e92fb3dbdf5ee5fb8b4216a5822e6bdb99810c1602a35466896": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01AMh9tWphw8PSyBnxwV9XmZ",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-order-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded with a placed order in the response.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          },
          "responseBody": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "r1-order-probe",
        "requirement": "R1",
        "description": "The backend's latest order has status 'placed' and contains at least one item.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "id",
            "status",
            "items"
           ],
           "properties": {
            "status": {
             "const": "placed"
            },
            "items": {
             "type": "array",
             "minItems": 1
            }
           }
          }
         }
        }
       },
       {
        "id": "r2-giftwrap-probe",
        "requirement": "R2",
        "description": "The backend's latest placed order has giftWrap set to true.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "status",
            "giftWrap"
           ],
           "properties": {
            "status": {
             "const": "placed"
            },
            "giftWrap": {
             "const": true
            }
           }
          }
         }
        }
       },
       {
        "id": "r2-giftwrap-request",
        "requirement": "R2",
        "description": "The last order-creation request asked for gift wrap and the server confirmed giftWrap true.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "response",
          "match": {
           "method": "POST",
           "url": {
            "path": "/api/orders"
           },
           "status": {
            "gte": 200,
            "lt": 300
           }
          },
          "pick": "last"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "giftWrap"
           ],
           "properties": {
            "giftWrap": {
             "const": true
            }
           }
          }
         }
        }
       }
      ]
     }
    }
   ],
