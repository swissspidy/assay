    {
     "id": "toolu_01B4tWnrzWBn8KRhpxrJutMm",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "order-placed-request",
        "requirement": "R2",
        "description": "A POST to /api/orders succeeded (2xx), placing an order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "order-placed-probe",
        "requirement": "R2",
        "description": "The backend's latest order has status 'placed'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
         },
         "expect": {
          "equals": "placed"
         }
        }
       },
       {
        "id": "giftwrap-probe",
        "requirement": "R1",
        "description": "The backend's latest order has giftWrap set to true.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/giftWrap"
         },
         "expect": {
          "equals": true
         }
        }
       },
       {
        "id": "giftwrap-request",
        "requirement": "R1",
        "description": "The last successful order POST sent giftWrap true.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "request",
          "match": {
           "method": "POST",
           "url": {
            "path": "/api/orders"
           },
           "status": {
            "gte": 200,
            "lt": 300
           }
          },
          "pick": "last",
          "pointer": "/giftWrap"
         },
         "expect": {
          "equals": true
         }
        }
       }
      ]
     }
    }
   ],
