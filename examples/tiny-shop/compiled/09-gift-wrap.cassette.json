   "toolCalls": [
    {
     "id": "toolu_016GDsxhXp61Drt1QZ9ffBq2",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "order-placed-request",
        "requirement": "R2",
        "description": "A POST to /api/orders succeeded, placing an order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "order-placed-probe",
        "requirement": "R2",
        "description": "The backend's latest order is the one created by the checkout request and has status placed.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/status"
           },
           "expect": {
            "equals": "placed"
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           },
           "expect": {
            "sameAs": {
             "source": {
              "from": "response",
              "match": {
               "method": "POST",
               "url": {
                "path": "/api/orders"
               },
               "status": {
                "gte": 200,
                "lt": 300
               }
              },
              "pick": "last",
              "pointer": "/id"
             }
            }
           }
          }
         ]
        }
       },
       {
        "id": "order-gift-wrapped",
        "requirement": "R1",
        "description": "The stored latest order has gift wrap enabled.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/giftWrap"
         },
         "expect": {
          "equals": true
         }
        }
       }
      ]
     }
    }
   ],
