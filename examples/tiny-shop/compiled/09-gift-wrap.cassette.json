  "sha256:9883e5119716b16a4e09f264c9b34d194897e422ce7c86eb8ec515349221be70": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01XooQUPc3vRFoDpxAbCbqJ9",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "order-placed-request",
        "requirement": "R2",
        "description": "A POST to /api/orders succeeded, creating an order from the cart.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "order-placed-probe",
        "requirement": "R2",
        "description": "The backend's latest order exists with status 'placed'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "id": {
             "type": "string",
             "minLength": 1
            },
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "order-gift-wrapped",
        "requirement": "R1",
        "description": "The backend's latest order is stored with giftWrap true.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/giftWrap"
         },
         "expect": {
          "equals": true
         }
        }
       }
      ]
     }
    }
   ],
