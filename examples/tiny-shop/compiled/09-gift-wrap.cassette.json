   "toolCalls": [
    {
     "id": "toolu_01JHGSB2BrT72ypwgACzViBe",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "R2-order-request",
        "requirement": "R2",
        "description": "A POST to /api/orders succeeded, placing an order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "R2-order-placed-probe",
        "requirement": "R2",
        "description": "The backend's latest order exists with status placed.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "R1-giftwrap-probe",
        "requirement": "R1",
        "description": "The backend's latest placed order has giftWrap set to true.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "giftWrap",
            "status"
           ],
           "properties": {
            "giftWrap": {
             "const": true
            },
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "R1-giftwrap-response",
        "requirement": "R1",
        "description": "The last successful order creation response shows giftWrap true.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "response",
          "match": {
           "method": "POST",
           "url": {
            "path": "/api/orders"
           },
           "status": {
            "gte": 200,
            "lt": 300
           }
          },
          "pick": "last",
          "pointer": "/giftWrap"
         },
         "expect": {
          "equals": true
         }
        }
       }
      ]
     }
    }
   ],
