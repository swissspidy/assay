{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/07-express-order",
  "version": "1",
  "task": {
    "instruction": "Order what is in my cart with express shipping, in the name of Ada Lovelace.",
    "outcomes": "Then an order is placed\nThen the order ships express\nThen the order confirmation is shown"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "An order is placed.",
      "source": {
        "field": "outcomes",
        "quote": "an order is placed"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The order uses express shipping.",
      "source": {
        "field": "outcomes",
        "quote": "the order ships express"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The order confirmation is shown.",
      "source": {
        "field": "outcomes",
        "quote": "the order confirmation is shown"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "The order is placed in the name of Ada Lovelace.",
      "source": {
        "field": "instruction",
        "quote": "in the name of Ada Lovelace"
      }
    },
    {
      "id": "R5",
      "kind": "hard",
      "text": "The order contains the items that are in the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Order what is in my cart"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-order-request",
      "requirement": "R1",
      "description": "A POST to /api/orders succeeded and the server reports the latest order as placed.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "request",
            "match": {
              "method": "POST",
              "url": {
                "path": "/api/orders"
              },
              "status": {
                "gte": 200,
                "lt": 300
              }
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "probe",
              "probe": "latestOrder"
            },
            "expect": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "placed"
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "r2-express",
      "requirement": "R2",
      "description": "The latest order for Ada Lovelace stored on the server uses express shipping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder"
        },
        "expect": {
          "schema": {
            "type": "object",
            "required": [
              "name",
              "shipping"
            ],
            "properties": {
              "name": {
                "const": "Ada Lovelace"
              },
              "shipping": {
                "const": "express"
              }
            }
          }
        }
      }
    },
    {
      "id": "r4-name",
      "requirement": "R4",
      "description": "The order was submitted and stored in the name of Ada Lovelace.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "request",
            "match": {
              "method": "POST",
              "url": {
                "path": "/api/orders"
              },
              "status": {
                "gte": 200,
                "lt": 300
              },
              "requestBody": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^\\s*Ada Lovelace\\s*$"
                  }
                }
              }
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/name"
            },
            "normalize": [
              "trim"
            ],
            "expect": {
              "equals": "Ada Lovelace"
            }
          }
        ]
      }
    },
    {
      "id": "r3-confirmation",
      "requirement": "R3",
      "description": "The browser shows the confirmation page for the placed order: URL /orders/<id> matching the latest order and an 'Order confirmed' heading.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "value",
            "source": {
              "from": "url",
              "part": "pathname"
            },
            "normalize": [
              {
                "op": "extract",
                "regex": "/orders/([^/]+)",
                "group": 1
              }
            ],
            "expect": {
              "sameAs": {
                "source": {
                  "from": "probe",
                  "probe": "latestOrder",
                  "pointer": "/id"
                }
              }
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "heading",
              "name": {
                "contains": "Order confirmed",
                "ignoreCase": true
              }
            }
          }
        ]
      }
    },
    {
      "id": "r5-cart-items",
      "requirement": "R5",
      "description": "The latest order contains the same products and quantities that were in the cart before the task.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "value",
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/items"
            },
            "normalize": [
              {
                "op": "items",
                "pointer": "/sku"
              }
            ],
            "expect": {
              "sameAs": {
                "source": {
                  "from": "probe",
                  "probe": "cart",
                  "pointer": "/items",
                  "at": "before"
                },
                "normalize": [
                  {
                    "op": "items",
                    "pointer": "/sku"
                  }
                ]
              }
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/items"
            },
            "normalize": [
              {
                "op": "items",
                "pointer": "/qty"
              }
            ],
            "expect": {
              "sameAs": {
                "source": {
                  "from": "probe",
                  "probe": "cart",
                  "pointer": "/items",
                  "at": "before"
                },
                "normalize": [
                  {
                    "op": "items",
                    "pointer": "/qty"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-04T23:12:48.232Z"
  }
}
