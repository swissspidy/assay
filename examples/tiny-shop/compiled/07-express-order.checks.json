{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/07-express-order",
  "version": "1",
  "task": {
    "instruction": "Order what is in my cart with express shipping, in the name of Ada Lovelace.",
    "outcomes": "Then an order is placed\nThen the order ships express\nThen the order confirmation is shown"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "An order is placed.",
      "source": {
        "field": "outcomes",
        "quote": "Then an order is placed"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The order uses express shipping.",
      "source": {
        "field": "outcomes",
        "quote": "Then the order ships express"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The order confirmation is shown.",
      "source": {
        "field": "outcomes",
        "quote": "Then the order confirmation is shown"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "The order is placed in the name of Ada Lovelace.",
      "source": {
        "field": "instruction",
        "quote": "in the name of Ada Lovelace"
      }
    },
    {
      "id": "R5",
      "kind": "hard",
      "text": "The order contains the items that were in the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Order what is in my cart"
      }
    }
  ],
  "checks": [
    {
      "id": "R1-order-request",
      "requirement": "R1",
      "description": "A POST to /api/orders succeeded with a 2xx status.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        },
        "count": {
          "gte": 1
        }
      }
    },
    {
      "id": "R1-order-probe",
      "requirement": "R1",
      "description": "The backend's latest order exists with status placed.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
        },
        "expect": {
          "equals": "placed"
        }
      }
    },
    {
      "id": "R2-shipping-express",
      "requirement": "R2",
      "description": "The backend's latest order uses express shipping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
        },
        "normalize": [
          "trim",
          "lowercase"
        ],
        "expect": {
          "equals": "express"
        }
      }
    },
    {
      "id": "R3-confirmation-page",
      "requirement": "R3",
      "description": "The browser is on an order page showing an 'Order confirmed' heading.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/orders/*"
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "heading",
              "name": {
                "contains": "confirmed",
                "ignoreCase": true
              }
            }
          }
        ]
      }
    },
    {
      "id": "R4-name",
      "requirement": "R4",
      "description": "The backend's latest order is in the name of Ada Lovelace.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
        },
        "normalize": [
          "trim",
          "collapseWhitespace"
        ],
        "expect": {
          "equals": "Ada Lovelace"
        }
      }
    },
    {
      "id": "R5-items",
      "requirement": "R5",
      "description": "The backend's latest order contains the cart item Blue Mug (MUG-BLUE), quantity 1.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
        },
        "expect": {
          "schema": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "sku": {
                  "const": "MUG-BLUE"
                },
                "qty": {
                  "const": 1
                }
              },
              "required": [
                "sku",
                "qty"
              ]
            }
          }
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-04T09:29:41.825Z"
  }
}
