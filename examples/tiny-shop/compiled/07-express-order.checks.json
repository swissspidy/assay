{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/07-express-order",
  "version": "1",
  "task": {
    "instruction": "Order what is in my cart with express shipping, in the name of Ada Lovelace.",
    "outcomes": "Then an order is placed\nThen the order ships express\nThen the order confirmation is shown"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "An order is placed.",
      "source": {
        "field": "outcomes",
        "quote": "an order is placed"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The order uses express shipping.",
      "source": {
        "field": "outcomes",
        "quote": "the order ships express"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The order confirmation is shown.",
      "source": {
        "field": "outcomes",
        "quote": "the order confirmation is shown"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "The order contains the items in the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Order what is in my cart"
      }
    },
    {
      "id": "R5",
      "kind": "hard",
      "text": "The order is placed in the name of Ada Lovelace.",
      "source": {
        "field": "instruction",
        "quote": "in the name of Ada Lovelace"
      }
    }
  ],
  "checks": [
    {
      "id": "order-created-request",
      "requirement": "R1",
      "description": "A POST to /api/orders succeeded (2xx), creating an order.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        }
      }
    },
    {
      "id": "order-placed-probe",
      "requirement": "R1",
      "description": "The backend's latest order has status 'placed'.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
        },
        "expect": {
          "equals": "placed"
        }
      }
    },
    {
      "id": "order-express",
      "requirement": "R2",
      "description": "The latest order stored by the backend uses express shipping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
        },
        "expect": {
          "equals": "express"
        }
      }
    },
    {
      "id": "confirmation-url",
      "requirement": "R3",
      "description": "The page URL is the confirmation page of the latest order (/orders/<id>).",
      "assert": {
        "kind": "value",
        "source": {
          "from": "url",
          "part": "pathname"
        },
        "normalize": [
          {
            "op": "extract",
            "regex": "^/orders/([^/]+)/?$",
            "group": 1
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "confirmation-heading",
      "requirement": "R3",
      "description": "The main area shows an 'Order confirmed' heading.",
      "assert": {
        "kind": "contains",
        "scope": {
          "role": "main"
        },
        "match": {
          "role": "heading",
          "name": {
            "contains": "Order confirmed",
            "ignoreCase": true
          }
        }
      }
    },
    {
      "id": "confirmation-order-number",
      "requirement": "R3",
      "description": "The order summary shows the order number of the latest order.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "text",
          "scope": {
            "role": "region",
            "name": "Order summary"
          },
          "pattern": "Order number:\\s*([A-Za-z0-9-]+)",
          "group": 1
        },
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "order-items-match-cart",
      "requirement": "R4",
      "description": "The latest order's items are exactly the items that were in the cart before the task.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
        },
        "normalize": [
          {
            "op": "items"
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
            },
            "normalize": [
              {
                "op": "items"
              }
            ]
          }
        }
      }
    },
    {
      "id": "order-name",
      "requirement": "R5",
      "description": "The latest order is in the name of Ada Lovelace.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
        },
        "normalize": [
          "trim"
        ],
        "expect": {
          "equals": "Ada Lovelace"
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T21:06:46.290Z"
  }
}
