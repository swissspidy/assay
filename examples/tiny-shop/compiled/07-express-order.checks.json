{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/07-express-order",
  "version": "1",
  "task": {
    "instruction": "Order what is in my cart with express shipping, in the name of Ada Lovelace.",
    "outcomes": "Then an order is placed\nThen the order ships express\nThen the order confirmation is shown"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "An order is placed.",
      "source": {
        "field": "outcomes",
        "quote": "an order is placed"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The order uses express shipping.",
      "source": {
        "field": "outcomes",
        "quote": "the order ships express"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The order confirmation is shown.",
      "source": {
        "field": "outcomes",
        "quote": "the order confirmation is shown"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "The order is placed in the name of Ada Lovelace.",
      "source": {
        "field": "instruction",
        "quote": "in the name of Ada Lovelace"
      }
    },
    {
      "id": "R5",
      "kind": "hard",
      "text": "The order contains the items that were in the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Order what is in my cart"
      }
    }
  ],
  "checks": [
    {
      "id": "R1-order-request",
      "requirement": "R1",
      "description": "The browser POSTed to /api/orders and the server answered with a successful status.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        },
        "count": {
          "gte": 1
        }
      }
    },
    {
      "id": "R1-order-placed-probe",
      "requirement": "R1",
      "description": "The backend's latest order exists with status 'placed'.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
        },
        "expect": {
          "equals": "placed"
        }
      }
    },
    {
      "id": "R2-express",
      "requirement": "R2",
      "description": "The backend's latest order has shipping set to express.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
        },
        "normalize": [
          "trim",
          "lowercase"
        ],
        "expect": {
          "equals": "express"
        }
      }
    },
    {
      "id": "R4-name",
      "requirement": "R4",
      "description": "The backend's latest order is in the name of Ada Lovelace.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
        },
        "normalize": [
          "trim",
          "collapseWhitespace"
        ],
        "expect": {
          "equals": "Ada Lovelace"
        }
      }
    },
    {
      "id": "R5-items-match-cart",
      "requirement": "R5",
      "description": "The latest order's items (sku and quantity) are exactly the items that were in the cart before the task.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
        },
        "normalize": [
          {
            "op": "items",
            "pick": [
              "/sku",
              "/qty"
            ]
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
            },
            "normalize": [
              {
                "op": "items",
                "pick": [
                  "/sku",
                  "/qty"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "R3-confirmation-url",
      "requirement": "R3",
      "description": "The browser ends on an order page /orders/<id>.",
      "assert": {
        "kind": "url",
        "match": {
          "path": "/orders/*"
        }
      }
    },
    {
      "id": "R3-confirmation-is-latest-order",
      "requirement": "R3",
      "description": "The order page shown is for the order the backend just stored.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "url",
          "part": "pathname"
        },
        "normalize": [
          {
            "op": "extract",
            "regex": "^/orders/([^/]+)/?$",
            "group": 1
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
            }
          }
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T10:42:45.661Z"
  }
}
