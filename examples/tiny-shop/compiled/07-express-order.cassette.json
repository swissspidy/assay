  "sha256:525f7697426f7c25b4ceb928789994bb4edc3e7591c9d3d445f898f36f29cec4": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_011cC27oKon8b2UofGTU2bGv",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-order-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded and the server reports the latest order as placed.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "request",
           "match": {
            "method": "POST",
            "url": {
             "path": "/api/orders"
            },
            "status": {
             "gte": 200,
             "lt": 300
            }
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder"
           },
           "expect": {
            "schema": {
             "type": "object",
             "required": [
              "id",
              "status"
             ],
             "properties": {
              "status": {
               "const": "placed"
              }
             }
            }
           }
          }
         ]
        }
       },
       {
        "id": "r2-express",
        "requirement": "R2",
        "description": "The latest order for Ada Lovelace stored on the server uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "name",
            "shipping"
           ],
           "properties": {
            "name": {
             "const": "Ada Lovelace"
            },
            "shipping": {
             "const": "express"
            }
           }
          }
         }
        }
       },
       {
        "id": "r4-name",
        "requirement": "R4",
        "description": "The order was submitted and stored in the name of Ada Lovelace (with express shipping).",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "request",
           "match": {
            "method": "POST",
            "url": {
             "path": "/api/orders"
            },
            "status": {
             "gte": 200,
             "lt": 300
            },
            "requestBody": {
             "type": "object",
             "required": [
              "name"
             ],
             "properties": {
              "name": {
               "type": "string",
               "pattern": "^\\s*Ada Lovelace\\s*$"
              }
             }
            }
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/name"
           },
           "normalize": [
            "trim"
           ],
           "expect": {
            "equals": "Ada Lovelace"
           }
          }
         ]
        }
       },
       {
        "id": "r3-confirmation",
        "requirement": "R3",
        "description": "The browser shows the confirmation page for the placed order: URL /orders/<id> matching the latest order and an 'Order confirmed' heading.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "url",
            "part": "pathname"
           },
           "normalize": [
            {
             "op": "extract",
             "regex": "/orders/([^/]+)",
             "group": 1
            }
           ],
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
             }
            }
           }
          },
          {
           "kind": "contains",
           "scope": {
            "landmark": {
             "role": "main"
            },
            "role": "main"
           },
           "match": {
            "role": "heading",
            "name": {
             "contains": "Order confirmed",
             "ignoreCase": true
            }
           }
          }
         ]
        }
       },
       {
        "id": "r5-cart-items",
        "requirement": "R5",
        "description": "The latest order contains the same products and quantities that were in the cart before the task.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/items"
           },
           "normalize": [
            {
             "op": "items",
             "pointer": "/sku"
            }
           ],
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
             },
             "normalize": [
              {
               "op": "items",
               "pointer": "/sku"
              }
             ]
            }
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/items"
           },
           "normalize": [
            {
             "op": "items",
             "pointer": "/qty"
            }
           ],
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
             },
             "normalize": [
              {
               "op": "items",
               "pointer": "/qty"
              }
             ]
            }
           }
          }
         ]
        }
       }
      ]
     }
    }
   ],
