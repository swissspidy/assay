  "sha256:36fcbac7fc1bd23ce16ad3257554dbdaa85b4803d8fbccb28fee03e418c26830": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01FjmudrLM5ck8jXYyg8z5aZ",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "R1-order-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded with a 2xx status.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         },
         "count": {
          "gte": 1
         }
        }
       },
       {
        "id": "R1-order-probe",
        "requirement": "R1",
        "description": "The backend's latest order exists with status placed.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
         },
         "expect": {
          "equals": "placed"
         }
        }
       },
       {
        "id": "R2-shipping-express",
        "requirement": "R2",
        "description": "The backend's latest order uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "normalize": [
          "trim",
          "lowercase"
         ],
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "R3-confirmation-page",
        "requirement": "R3",
        "description": "The browser is on an order page showing an 'Order confirmed' heading with the order number in the summary.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/orders/*"
           }
          },
          {
           "kind": "contains",
           "scope": {
            "landmark": {
             "role": "main"
            },
            "role": "main"
           },
           "match": {
            "role": "heading",
            "name": {
             "contains": "confirmed",
             "ignoreCase": true
            }
           }
          }
         ]
        }
       },
       {
        "id": "R4-name",
        "requirement": "R4",
        "description": "The backend's latest order is in the name of Ada Lovelace.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
         },
         "normalize": [
          "trim",
          "collapseWhitespace"
         ],
         "expect": {
          "equals": "Ada Lovelace"
         }
        }
       },
       {
        "id": "R5-items",
        "requirement": "R5",
        "description": "The backend's latest order contains the cart item Blue Mug (MUG-BLUE), quantity 1.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "sku": {
              "const": "MUG-BLUE"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "sku",
             "qty"
            ]
           }
          }
         }
        }
       }
      ]
     }
    }
   ],
