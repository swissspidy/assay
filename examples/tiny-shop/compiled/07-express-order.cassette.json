  "sha256:3032c5c0fa99358a124596beb55303c719f2812302f4a84326f908cff200af1f": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01GFaS6B2HJS5poKpjFUn4uk",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-order-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded with a 2xx status.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "r1-order-placed-probe",
        "requirement": "R1",
        "description": "The backend's latest order exists and has status 'placed'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "id": {
             "type": "string",
             "minLength": 1
            },
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "r2-express",
        "requirement": "R2",
        "description": "The backend's latest order uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "r3-url",
        "requirement": "R3",
        "description": "The browser is on the order page whose id matches the latest order.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "url",
          "part": "pathname"
         },
         "normalize": [
          {
           "op": "extract",
           "regex": "^/orders/([^/]+)/?$",
           "group": 1
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       },
       {
        "id": "r3-heading",
        "requirement": "R3",
        "description": "The main area shows the 'Order confirmed' heading.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "main"
         },
         "match": {
          "role": "heading",
          "name": {
           "contains": "Order confirmed",
           "ignoreCase": true
          }
         }
        }
       },
       {
        "id": "r3-order-number",
        "requirement": "R3",
        "description": "The order summary shows the order number of the latest order.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "text",
          "scope": {
           "anchors": [
            {
             "role": "region",
             "name": "Order summary"
            }
           ]
          },
          "pattern": "Order number:\\s*([A-Za-z0-9-]+)",
          "group": 1
         },
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       },
       {
        "id": "r4-name",
        "requirement": "R4",
        "description": "The latest order is in the name of Ada Lovelace.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
         },
         "normalize": [
          "trim",
          "collapseWhitespace"
         ],
         "expect": {
          "equals": "Ada Lovelace"
         }
        }
       },
       {
        "id": "r5-items",
        "requirement": "R5",
        "description": "The latest order's items equal the cart's items before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items"
            }
           ]
          }
         }
        }
       }
      ]
     }
    }
   ],
