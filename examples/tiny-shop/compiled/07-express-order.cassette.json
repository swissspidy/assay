  "sha256:becd79921f4af92b8178ee0069b47ae7fd78294bc59f9c4fba433740cf396d6e": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01Xq1m4AM6Kx6Yy6FsCMVXVS",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-order-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded with a 2xx status.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         },
         "count": {
          "gte": 1
         }
        }
       },
       {
        "id": "r1-order-stored",
        "requirement": "R1",
        "description": "The backend's latest order exists with status 'placed'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "id": {
             "type": "string",
             "minLength": 1
            },
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "r2-express",
        "requirement": "R2",
        "description": "The backend's latest order has shipping set to 'express'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "r3-url",
        "requirement": "R3",
        "description": "The browser is on the order page of the order the backend stored.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "url",
          "part": "pathname"
         },
         "normalize": [
          {
           "op": "extract",
           "regex": "^/orders/([^/]+)/?$",
           "group": 1
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       },
       {
        "id": "r3-heading",
        "requirement": "R3",
        "description": "The page shows an 'Order confirmed' heading in main.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "main"
         },
         "match": {
          "role": "heading",
          "name": {
           "contains": "Order confirmed",
           "ignoreCase": true
          }
         }
        }
       },
       {
        "id": "r3-order-number",
        "requirement": "R3",
        "description": "The order summary shows the order number of the stored order.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "text",
          "scope": {
           "role": "region",
           "name": "Order summary"
          },
          "pattern": "Order number:\\s*([A-Za-z0-9-]+)",
          "group": 1
         },
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       },
       {
        "id": "r4-items-match-cart",
        "requirement": "R4",
        "description": "The order's items equal the cart's items before the task (whole items, any order).",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items"
            }
           ]
          }
         }
        }
       },
       {
        "id": "r5-name",
        "requirement": "R5",
        "description": "The backend's latest order is in the name of Ada Lovelace.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
         },
         "normalize": [
          "trim",
          "collapseWhitespace"
         ],
         "expect": {
          "equals": "Ada Lovelace"
         }
        }
       }
      ]
     }
    }
   ],
