  "sha256:66d44f67aadf3e6d5f4d19035614bbc2703c974728dc85e37469f1b0731a1e65": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01JNEJ4wmRJr7BUWEvTNYfEG",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "R1.order-post",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded and returned a placed order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          },
          "responseBody": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "R1.probe-placed",
        "requirement": "R1",
        "description": "The backend's latest order has status placed.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "R2.probe-express",
        "requirement": "R2",
        "description": "The backend's latest placed order for Ada Lovelace uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "shipping",
            "name",
            "status"
           ],
           "properties": {
            "shipping": {
             "const": "express"
            },
            "status": {
             "const": "placed"
            },
            "name": {
             "type": "string",
             "pattern": "^\\s*Ada Lovelace\\s*$"
            }
           }
          }
         }
        }
       },
       {
        "id": "R3.url",
        "requirement": "R3",
        "description": "The browser ends on an order confirmation page /orders/<id>.",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/orders/*"
         }
        }
       },
       {
        "id": "R3.heading",
        "requirement": "R3",
        "description": "The main area shows an 'Order confirmed' heading.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "main"
         },
         "match": {
          "role": "heading",
          "name": {
           "contains": "Order confirmed",
           "ignoreCase": true
          }
         }
        }
       },
       {
        "id": "R4.probe-items",
        "requirement": "R4",
        "description": "The latest placed order for Ada Lovelace contains the cart item Blue Mug (MUG-BLUE, qty 1).",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "items",
            "name",
            "status"
           ],
           "properties": {
            "status": {
             "const": "placed"
            },
            "name": {
             "type": "string",
             "pattern": "^\\s*Ada Lovelace\\s*$"
            },
            "items": {
             "type": "array",
             "minItems": 1,
             "contains": {
              "type": "object",
              "required": [
               "sku",
               "qty"
              ],
              "properties": {
               "sku": {
                "const": "MUG-BLUE"
               },
               "qty": {
                "const": 1
               }
              }
             }
            }
           }
          }
         }
        }
       },
       {
        "id": "R5.probe-name",
        "requirement": "R5",
        "description": "The latest placed order is in the name of Ada Lovelace.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "name",
            "status"
           ],
           "properties": {
            "status": {
             "const": "placed"
            },
            "name": {
             "type": "string",
             "pattern": "^\\s*Ada Lovelace\\s*$"
            }
           }
          }
         }
        }
       }
      ]
     }
    }
   ],
