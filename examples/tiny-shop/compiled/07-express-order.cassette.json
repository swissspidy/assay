  "sha256:5609b76302a797629109d7a29cee089aa7f1356d6e6da9e784a4d2431da78380": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01JfzJNcSXjBB7xtTuK7gCdR",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "R1-order-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded with a 2xx status.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "R1-order-placed-probe",
        "requirement": "R1",
        "description": "The backend's latest order has status 'placed'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
         },
         "expect": {
          "equals": "placed"
         }
        }
       },
       {
        "id": "R2-express",
        "requirement": "R2",
        "description": "The backend's latest order uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "normalize": [
          "trim",
          "lowercase"
         ],
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "R4-name",
        "requirement": "R4",
        "description": "The backend's latest order is in the name of Ada Lovelace.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
         },
         "normalize": [
          "trim",
          "collapseWhitespace"
         ],
         "expect": {
          "equals": "Ada Lovelace"
         }
        }
       },
       {
        "id": "R5-items-sku",
        "requirement": "R5",
        "description": "The latest order's item SKUs match the SKUs in the cart before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items",
           "pointer": "/sku"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items",
             "pointer": "/sku"
            }
           ]
          }
         }
        }
       },
       {
        "id": "R5-items-qty",
        "requirement": "R5",
        "description": "The latest order's item quantities match the cart before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items",
           "pointer": "/qty"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items",
             "pointer": "/qty"
            }
           ]
          }
         }
        }
       },
       {
        "id": "R3-url",
        "requirement": "R3",
        "description": "The browser is on the order confirmation page for the placed order.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "url",
          "part": "pathname"
         },
         "normalize": [
          {
           "op": "extract",
           "regex": "^/orders/([^/]+)/?$",
           "group": 1
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       },
       {
        "id": "R3-heading",
        "requirement": "R3",
        "description": "The main area shows an 'Order confirmed' heading.",
        "assert": {
         "kind": "contains",
         "scope": {
          "landmark": {
           "role": "main"
          },
          "role": "main"
         },
         "match": {
          "role": "heading",
          "name": {
           "contains": "Order confirmed",
           "ignoreCase": true
          }
         }
        }
       },
       {
        "id": "R3-order-number",
        "requirement": "R3",
        "description": "The order summary shows the order number of the latest backend order.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "node",
          "target": {
           "role": "paragraph",
           "text": {
            "contains": "Order number"
           },
           "within": {
            "role": "region",
            "name": "Order summary"
           }
          },
          "field": "text"
         },
         "normalize": [
          {
           "op": "extract",
           "regex": "Order number:?\\s*(\\S+)",
           "group": 1
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       }
      ]
     }
    }
   ],
