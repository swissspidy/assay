  "sha256:7f373738415ad073611fd616a79c48ddbed457525ef3a1975098c6850b677568": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01FfaaUZJxfUKJAEf5RPouGq",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "R1-order-request",
        "requirement": "R1",
        "description": "The browser POSTed to /api/orders and the server answered with a successful status.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         },
         "count": {
          "gte": 1
         }
        }
       },
       {
        "id": "R1-order-placed-probe",
        "requirement": "R1",
        "description": "The backend's latest order exists with status 'placed'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
         },
         "expect": {
          "equals": "placed"
         }
        }
       },
       {
        "id": "R2-express",
        "requirement": "R2",
        "description": "The backend's latest order has shipping set to express.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "normalize": [
          "trim",
          "lowercase"
         ],
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "R4-name",
        "requirement": "R4",
        "description": "The backend's latest order is in the name of Ada Lovelace.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
         },
         "normalize": [
          "trim",
          "collapseWhitespace"
         ],
         "expect": {
          "equals": "Ada Lovelace"
         }
        }
       },
       {
        "id": "R5-items-match-cart",
        "requirement": "R5",
        "description": "The latest order's items (sku and quantity) are exactly the items that were in the cart before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items",
           "pick": [
            "/sku",
            "/qty"
           ]
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items",
             "pick": [
              "/sku",
              "/qty"
             ]
            }
           ]
          }
         }
        }
       },
       {
        "id": "R3-confirmation-url",
        "requirement": "R3",
        "description": "The browser ends on an order page /orders/<id>.",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/orders/*"
         }
        }
       },
       {
        "id": "R3-confirmation-is-latest-order",
        "requirement": "R3",
        "description": "The order page shown is for the order the backend just stored.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "url",
          "part": "pathname"
         },
         "normalize": [
          {
           "op": "extract",
           "regex": "^/orders/([^/]+)/?$",
           "group": 1
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       }
      ]
     }
    }
   ],
