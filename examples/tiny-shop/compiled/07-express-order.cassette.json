  "sha256:8acf54124e631039a3dffb6d2d201dae244766a77072a675c1fcc7c034bfaf24": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01Eexn1CLuPEZT38krgQwo4V",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "order-placed-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded and the server responded with a placed order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          },
          "responseBody": {
           "type": "object",
           "properties": {
            "status": {
             "const": "placed"
            }
           },
           "required": [
            "status"
           ]
          }
         }
        }
       },
       {
        "id": "order-placed-probe",
        "requirement": "R1",
        "description": "The backend's latest order has status 'placed'.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
         },
         "expect": {
          "equals": "placed"
         }
        }
       },
       {
        "id": "order-express-probe",
        "requirement": "R2",
        "description": "The backend's latest order uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "order-name-probe",
        "requirement": "R4",
        "description": "The backend's latest order is in the name of Ada Lovelace.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/name"
         },
         "normalize": [
          "trim"
         ],
         "expect": {
          "equals": "Ada Lovelace"
         }
        }
       },
       {
        "id": "order-items-match-cart",
        "requirement": "R5",
        "description": "The latest order's items equal the items that were in the cart before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items"
            }
           ]
          }
         }
        }
       },
       {
        "id": "confirmation-page",
        "requirement": "R3",
        "description": "The browser is on the order page with an 'Order confirmed' heading.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/orders/*"
           }
          },
          {
           "kind": "contains",
           "scope": {
            "landmark": {
             "role": "main"
            },
            "role": "main"
           },
           "match": {
            "role": "heading",
            "name": {
             "contains": "Order confirmed",
             "ignoreCase": true
            }
           }
          }
         ]
        }
       },
       {
        "id": "confirmation-shows-latest-order",
        "requirement": "R3",
        "description": "The order number in the URL is the id of the latest order stored by the backend.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "url",
          "part": "pathname"
         },
         "normalize": [
          {
           "op": "extract",
           "regex": "^/orders/([^/]+)/?$",
           "group": 1
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       }
      ]
     }
    }
   ],
