    {
     "id": "toolu_01BovUYcTe33b2KUnr85NyYC",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-confirmation-page-is-order",
        "requirement": "R1",
        "description": "The browser ends on the confirmation page of the order just placed (URL /orders/<id> matching the latest order's id).",
        "assert": {
         "kind": "value",
         "source": {
          "from": "url",
          "part": "pathname"
         },
         "normalize": [
          {
           "op": "extract",
           "regex": "^/orders/([^/]+)/?$",
           "group": 1
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/id"
           }
          }
         }
        }
       },
       {
        "id": "r1-confirmation-shows-5-nov-2026",
        "requirement": "R1",
        "description": "The order summary on the confirmation page shows an estimated delivery of 5 November 2026.",
        "assert": {
         "kind": "each",
         "scope": {
          "role": "region",
          "name": "Order summary"
         },
         "witness": {
          "role": "paragraph",
          "text": {
           "contains": "Estimated delivery"
          }
         },
         "match": {
          "role": "paragraph",
          "text": {
           "contains": "Estimated delivery"
          }
         },
         "count": {
          "eq": 1
         },
         "assert": {
          "kind": "value",
          "source": {
           "from": "text",
           "pattern": "Estimated delivery:?\\s*(.+?)\\s*$",
           "group": 1
          },
          "normalize": [
           {
            "op": "date",
            "locale": "en-GB"
           }
          ],
          "expect": {
           "equals": "2026-11-05"
          }
         }
        }
       },
       {
        "id": "r2-order-created-request",
        "requirement": "R2",
        "description": "An order creation request POST /api/orders succeeded.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "r2-order-items-match-cart",
        "requirement": "R2",
        "description": "The latest placed order contains exactly the items that were in the cart before the task.",
        "assert": {
         "allOf": [
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/status"
           },
           "expect": {
            "equals": "placed"
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/items"
           },
           "normalize": [
            {
             "op": "items"
            }
           ],
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
             },
             "normalize": [
              {
               "op": "items"
              }
             ]
            }
           }
          }
         ]
        }
       },
       {
        "id": "r3-express-shipping",
        "requirement": "R3",
        "description": "The latest order stored by the backend uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "r4-delivery-date-shown-matches-order",
        "requirement": "R4",
        "description": "The confirmation's order summary shows the estimated delivery date the backend stored for the order.",
        "assert": {
         "kind": "each",
         "scope": {
          "role": "region",
          "name": "Order summary"
         },
         "witness": {
          "role": "paragraph",
          "text": {
           "contains": "Estimated delivery"
          }
         },
         "match": {
          "role": "paragraph",
          "text": {
           "contains": "Estimated delivery"
          }
         },
         "count": {
          "eq": 1
         },
         "assert": {
          "kind": "value",
          "source": {
           "from": "text",
           "pattern": "Estimated delivery:?\\s*(.+?)\\s*$",
           "group": 1
          },
          "normalize": [
           {
            "op": "date",
            "locale": "en-GB"
           }
          ],
          "expect": {
           "sameAs": {
            "source": {
             "from": "probe",
             "probe": "latestOrder",
             "pointer": "/estimatedDelivery"
            },
            "normalize": [
             {
              "op": "date",
              "locale": "en-GB"
             }
            ]
           }
          }
         }
        }
       }
      ]
     }
    }
