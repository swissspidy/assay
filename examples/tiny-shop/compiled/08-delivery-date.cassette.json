  "sha256:ee9b9e0b856eebc4f311fe827e4df413088d589f5a60c6c57fbe9d57e004f8dd": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01PAU65VFwr5PwUFYnbA4RV9",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-confirmation-page",
        "requirement": "R1",
        "description": "The browser is on the order confirmation page for the latest order.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/orders/*"
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "url",
            "part": "pathname"
           },
           "normalize": [
            {
             "op": "extract",
             "regex": "^/orders/([^/]+)/?$",
             "group": 1
            }
           ],
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
             }
            }
           }
          }
         ]
        }
       },
       {
        "id": "r1-delivery-date-shown",
        "requirement": "R1",
        "description": "The order summary on the confirmation shows an estimated delivery date of 5 November 2026.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "text",
          "scope": {
           "anchors": [
            {
             "role": "region",
             "name": {
              "contains": "Order summary",
              "ignoreCase": true
             }
            }
           ]
          },
          "pattern": "Estimated delivery:?\\s*([^\\n]+?)\\s*(?:Total|$|\\n)",
          "flags": "i",
          "group": 1
         },
         "normalize": [
          "trim",
          {
           "op": "date",
           "locale": "en-GB"
          }
         ],
         "expect": {
          "equals": "2026-11-05"
         }
        }
       },
       {
        "id": "r1-delivery-date-backend",
        "requirement": "R1",
        "description": "The placed order's estimated delivery recorded by the backend is 2026-11-05.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/estimatedDelivery"
         },
         "expect": {
          "equals": "2026-11-05"
         }
        }
       },
       {
        "id": "r2-order-request",
        "requirement": "R2",
        "description": "A POST to /api/orders succeeded.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         },
         "count": {
          "gte": 1
         }
        }
       },
       {
        "id": "r2-order-items-match-cart",
        "requirement": "R2",
        "description": "The latest order's items (sku and qty) are exactly the items that were in the cart before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items",
           "pointer": "/sku"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items",
             "pointer": "/sku"
            }
           ]
          }
         }
        }
       },
       {
        "id": "r2-order-qty-match-cart",
        "requirement": "R2",
        "description": "The latest order's item quantities match the cart before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items",
           "pointer": "/qty"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items",
             "pointer": "/qty"
            }
           ]
          }
         }
        }
       },
       {
        "id": "r3-express-backend",
        "requirement": "R3",
        "description": "The latest order stored by the backend uses express shipping.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
         },
         "expect": {
          "equals": "express"
         }
        }
       },
       {
        "id": "r3-express-request",
        "requirement": "R3",
        "description": "The order request was sent with shipping set to express.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "request",
          "match": {
           "method": "POST",
           "url": {
            "path": "/api/orders"
           },
           "status": {
            "gte": 200,
            "lt": 300
           }
          },
          "pick": "last",
          "pointer": "/shipping"
         },
         "expect": {
          "equals": "express"
         }
        }
       }
      ]
     }
    }
   ],
