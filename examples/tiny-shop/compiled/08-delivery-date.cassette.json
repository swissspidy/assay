  "sha256:56b4a747a14be9025e48eb86652f9c1ac3186f4cac91e52018a212de67aec254": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_016xaaSCpFpgFPhJsTzkgVWY",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-order-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded and the server returned a placed order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          }
         }
        }
       },
       {
        "id": "r1-order-items-match-cart",
        "requirement": "R1",
        "description": "The latest order's items (sku and quantity) equal the cart's items before the task.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/status"
           },
           "expect": {
            "equals": "placed"
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/items"
           },
           "normalize": [
            {
             "op": "items",
             "pointer": "/sku"
            }
           ],
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
             },
             "normalize": [
              {
               "op": "items",
               "pointer": "/sku"
              }
             ]
            }
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/items"
           },
           "normalize": [
            {
             "op": "items",
             "pointer": "/qty"
            }
           ],
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
             },
             "normalize": [
              {
               "op": "items",
               "pointer": "/qty"
              }
             ]
            }
           }
          }
         ]
        }
       },
       {
        "id": "r2-express-shipping",
        "requirement": "R2",
        "description": "The stored latest order uses express shipping, and the order request asked for express.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/shipping"
           },
           "normalize": [
            "lowercase"
           ],
           "expect": {
            "equals": "express"
           }
          },
          {
           "kind": "request",
           "match": {
            "method": "POST",
            "url": {
             "path": "/api/orders"
            },
            "status": {
             "gte": 200,
             "lt": 300
            },
            "requestBody": {
             "type": "object",
             "properties": {
              "shipping": {
               "const": "express"
              }
             },
             "required": [
              "shipping"
             ]
            }
           }
          }
         ]
        }
       },
       {
        "id": "r3-confirmation-delivery-date",
        "requirement": "R3",
        "description": "The order confirmation summary for the latest order shows an estimated delivery of 5 November 2026.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "text",
            "scope": {
             "role": "main"
            },
            "pattern": "Estimated delivery:?\\s*([^\\n]+?)\\s*(?:Total|$)",
            "flags": "i",
            "group": 1
           },
           "normalize": [
            "trim",
            {
             "op": "date",
             "locale": "en-GB"
            }
           ],
           "expect": {
            "equals": "2026-11-05"
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "text",
            "scope": {
             "role": "main"
            },
            "pattern": "Order number:?\\s*([A-Z0-9-]+)",
            "flags": "i",
            "group": 1
           },
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
             }
            }
           }
          }
         ]
        }
       },
       {
        "id": "r4-delivery-shown-matches-order",
        "requirement": "R4",
        "description": "The estimated delivery date shown on the page matches the placed order's estimated delivery date.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "text",
          "scope": {
           "role": "main"
          },
          "pattern": "Estimated delivery:?\\s*([^\\n]+?)\\s*(?:Total|$)",
          "flags": "i",
          "group": 1
         },
         "normalize": [
          "trim",
          {
           "op": "date",
           "locale": "en-GB"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/estimatedDelivery"
           },
           "normalize": [
            {
             "op": "date",
             "locale": "en-GB"
            }
           ]
          }
         }
        }
       }
      ]
     }
    }
   ],
