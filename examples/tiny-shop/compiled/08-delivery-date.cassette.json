  "sha256:2b0e9c98b60e7ab5cd516554ab64c5d4bacccc36200698cc451744d9c14c9b14": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01BNYXjxQUiKbpsukyLgYHtr",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-order-request",
        "requirement": "R1",
        "description": "A POST to /api/orders succeeded and created a placed order.",
        "assert": {
         "kind": "request",
         "match": {
          "method": "POST",
          "url": {
           "path": "/api/orders"
          },
          "status": {
           "gte": 200,
           "lt": 300
          },
          "responseBody": {
           "type": "object",
           "required": [
            "id",
            "status"
           ],
           "properties": {
            "status": {
             "const": "placed"
            }
           }
          }
         }
        }
       },
       {
        "id": "r1-order-items-match-cart",
        "requirement": "R1",
        "description": "The latest order's items are exactly the items that were in the cart before the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
             "op": "items"
            }
           ]
          }
         }
        }
       },
       {
        "id": "r2-express-shipping",
        "requirement": "R2",
        "description": "The placed order (backend) uses express shipping, and the order request asked for express shipping.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "latestOrder",
            "pointer": "/shipping"
           },
           "expect": {
            "equals": "express"
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "request",
            "match": {
             "method": "POST",
             "url": {
              "path": "/api/orders"
             },
             "status": {
              "gte": 200,
              "lt": 300
             }
            },
            "pick": "last",
            "pointer": "/shipping"
           },
           "expect": {
            "equals": "express"
           }
          }
         ]
        }
       },
       {
        "id": "r3-confirmation-page",
        "requirement": "R3",
        "description": "The browser is on the confirmation page of the placed order, whose number matches the latest order.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/orders/*"
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "url",
            "part": "pathname"
           },
           "normalize": [
            {
             "op": "extract",
             "regex": "^/orders/([^/]+)/?$",
             "group": 1
            }
           ],
           "expect": {
            "sameAs": {
             "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
             }
            }
           }
          }
         ]
        }
       },
       {
        "id": "r3-delivery-date-shown",
        "requirement": "R3",
        "description": "The order summary on the confirmation shows an estimated delivery date of 5 November 2026.",
        "assert": {
         "kind": "each",
         "scope": {
          "anchors": [
           {
            "role": "region",
            "name": {
             "contains": "Order summary",
             "ignoreCase": true
            }
           }
          ]
         },
         "match": {
          "role": "paragraph",
          "text": {
           "contains": "Estimated delivery",
           "ignoreCase": true
          }
         },
         "count": {
          "eq": 1
         },
         "assert": {
          "kind": "value",
          "source": {
           "from": "text",
           "pattern": "Estimated delivery:?\\s*(.+?)\\s*$",
           "flags": "i",
           "group": 1
          },
          "normalize": [
           {
            "op": "date",
            "locale": "en-GB"
           }
          ],
          "expect": {
           "equals": "2026-11-05"
          }
         }
        }
       }
      ]
     }
    }
   ],
