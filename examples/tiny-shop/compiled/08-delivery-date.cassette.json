          "from": "probe",
          "probe": "latestOrder"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "status",
            "shipping"
           ],
           "properties": {
            "status": {
             "const": "placed"
            },
            "shipping": {
             "type": "string",
             "pattern": "^[Ee][Xx][Pp][Rr][Ee][Ss][Ss]$"
            }
           }
          }
         }
        }
       },
       {
