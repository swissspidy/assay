{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/06-cart-total",
  "version": "1",
  "task": {
    "instruction": "Add one Blue Mug and one Red Mug to my cart and open the cart.",
    "outcomes": "Then the cart total is $21.50"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The cart total is $21.50.",
      "source": {
        "field": "outcomes",
        "quote": "the cart total is $21.50"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "One Blue Mug is in the cart.",
      "source": {
        "field": "instruction",
        "quote": "Add one Blue Mug"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "One Red Mug is in the cart.",
      "source": {
        "field": "instruction",
        "quote": "one Red Mug"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "The cart is opened at the end.",
      "source": {
        "field": "instruction",
        "quote": "open the cart"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-total-backend",
      "requirement": "R1",
      "description": "The backend cart total is 21.50.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/total"
        },
        "expect": {
          "approx": {
            "value": 21.5,
            "abs": 0.001
          }
        }
      }
    },
    {
      "id": "r1-total-page",
      "requirement": "R1",
      "description": "The cart page's 'Cart total' status shows $21.50.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "node",
          "target": {
            "anchors": [
              {
                "role": "status",
                "name": "Cart total"
              },
              {
                "role": "status",
                "within": {
                  "role": "region",
                  "name": "Cart summary"
                }
              }
            ]
          },
          "field": "text"
        },
        "normalize": [
          {
            "op": "currency",
            "locale": "en-US",
            "currency": "USD"
          }
        ],
        "expect": {
          "approx": {
            "value": {
              "amount": 21.5,
              "currency": "USD"
            },
            "abs": 0.001
          }
        }
      }
    },
    {
      "id": "r2-blue-mug",
      "requirement": "R2",
      "description": "The backend cart holds a Blue Mug line with quantity 1.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
        },
        "expect": {
          "schema": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "sku": {
                  "const": "MUG-BLUE"
                },
                "qty": {
                  "const": 1
                }
              },
              "required": [
                "sku",
                "qty"
              ]
            }
          }
        }
      }
    },
    {
      "id": "r3-red-mug",
      "requirement": "R3",
      "description": "The backend cart holds a Red Mug line with quantity 1.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
        },
        "expect": {
          "schema": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "sku": {
                  "const": "MUG-RED"
                },
                "qty": {
                  "const": 1
                }
              },
              "required": [
                "sku",
                "qty"
              ]
            }
          }
        }
      }
    },
    {
      "id": "r4-cart-open",
      "requirement": "R4",
      "description": "The browser ends on the /cart page showing the 'Your cart' heading.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/cart"
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "heading",
              "name": "Your cart",
              "level": 1
            }
          }
        ]
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T11:29:53.844Z"
  }
}
