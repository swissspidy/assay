                },
                "field": "value"
              },
              "normalize": [
                {
                  "op": "number",
                  "locale": "en-US"
                }
              ],
              "expect": {
                "approx": {
                  "value": 3,
                  "abs": 0
                }
              }
            }
          }
        ]
      }
    }
