                "qty": {
                  "const": 3
                }
              },
              "required": [
                "sku",
                "qty"
              ]
            }
          }
        }
      }
    },
    {
      "id": "cart-page-blue-mug-qty-3",
      "requirement": "R1",
      "description": "The cart page's table shows quantity 3 in the Blue Mug row.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/cart"
            }
          },
          {
            "kind": "each",
            "scope": {
              "role": "table",
              "name": "Cart"
            },
            "match": {
