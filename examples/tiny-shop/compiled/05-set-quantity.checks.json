      "requirement": "R1",
      "description": "The cart page is shown and the Blue Mug quantity field in the Cart table reads 3.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/cart"
            }
          },
          {
            "kind": "state",
            "target": {
