            "type": "object",
            "properties": {
             "sku": {
              "const": "MUG-BLUE"
             },
             "qty": {
              "type": "number",
              "minimum": 1
             }
            },
            "required": [
             "sku",
             "qty"
            ]
           }
          }
         }
        }
       }
      ]
     }
    }
