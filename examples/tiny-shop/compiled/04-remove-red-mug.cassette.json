        "id": "R1-no-red-mug",
        "requirement": "R1",
        "description": "The backend cart probe shows no item named Red Mug (or with SKU MUG-RED) after the task.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart"
         },
         "expect": {
          "schema": {
           "type": "object",
           "required": [
            "items"
           ],
           "properties": {
            "items": {
             "type": "array",
             "not": {
              "contains": {
               "anyOf": [
                {
                 "type": "object",
                 "properties": {
                  "name": {
                   "const": "Red Mug"
                  }
                 },
                 "required": [
                  "name"
                 ]
                },
                {
                 "type": "object",
                 "properties": {
                  "sku": {
                   "const": "MUG-RED"
                  }
                 },
                 "required": [
                  "sku"
                 ]
                }
               ]
              }
             }
            }
           }
          }
         }
        }
       },
       {
        "id": "R2-others-kept",
        "requirement": "R2",
        "description": "The cart items after the task equal the cart items before the task minus the Red Mug.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "normalize": [
          {
           "op": "items"
          }
         ],
         "expect": {
          "sameAs": {
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/items",
            "at": "before"
           },
           "normalize": [
            {
