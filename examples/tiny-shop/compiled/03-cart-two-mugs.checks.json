                    "qty"
                  ],
                  "properties": {
                    "sku": {
                      "const": "MUG-BLUE"
                    },
                    "qty": {
                      "type": "number",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          {
            "kind": "url",
            "match": {
              "path": "/cart"
            }
          },
          {
            "kind": "contains",
            "scope": {
              "anchors": [
                {
                  "role": "table",
                  "name": "Cart"
                },
                {
                  "role": "table",
                  "landmark": {
                    "role": "main"
                  }
                }
              ]
            },
            "match": {
              "role": "cell",
              "name": {
                "equals": "Blue Mug"
              },
              "column": "Product"
            }
          }
        ]
      }
    },
    {
