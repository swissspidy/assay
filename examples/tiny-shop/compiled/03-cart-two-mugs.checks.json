      "description": "The backend cart holds a Blue Mug (MUG-BLUE, qty ≥1) and the cart page (/cart) shows a Blue Mug row in its Cart table.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "value",
            "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items"
            },
            "expect": {
