     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-cart-page-blue",
        "requirement": "R1",
        "description": "On the /cart page, the Cart table has a row for Blue Mug.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/cart"
           }
          },
          {
           "kind": "contains",
           "scope": {
            "anchors": [
             {
              "role": "table",
              "name": "Cart"
             },
             {
              "role": "table",
              "landmark": {
               "role": "main"
              }
             }
            ]
           },
           "match": {
            "role": "row",
            "text": {
             "contains": "Blue Mug"
            }
           }
          }
         ]
        }
       },
       {
        "id": "r1-backend-blue",
        "requirement": "R1",
        "description": "The backend cart holds a Blue Mug with quantity at least 1.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "required": [
             "name",
             "qty"
            ],
            "properties": {
             "name": {
              "const": "Blue Mug"
             },
             "qty": {
              "type": "number",
