        "requirement": "R1",
        "description": "The backend cart total is 21.50.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/total"
         },
         "expect": {
          "approx": {
           "value": 21.5,
           "abs": 0.001
          }
         }
        }
       },
       {
        "id": "r1-total-page",
        "requirement": "R1",
        "description": "The cart page shows a total of $21.50.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "node",
          "target": {
           "anchors": [
            {
             "role": "status",
             "name": "Cart total"
            },
            {
             "role": "status",
             "within": {
              "role": "region",
              "name": "Cart summary"
             }
            }
           ]
          },
          "field": "text"
         },
         "normalize": [
          {
           "op": "currency",
           "locale": "en-US",
           "currency": "USD"
          }
         ],
         "expect": {
          "approx": {
           "value": {
            "amount": 21.5,
            "currency": "USD"
           },
           "abs": 0.001
          }
         }
        }
       },
       {
        "id": "r2-blue-mug",
        "requirement": "R2",
        "description": "The backend cart contains Blue Mug with quantity 1.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "name": {
              "const": "Blue Mug"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "name",
             "qty"
            ]
           }
          }
         }
        }
       },
