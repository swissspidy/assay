             "name": {
              "const": "Red Mug"
             },
             "qty": {
              "const": 1
             }
            }
           }
          }
         }
        }
       },
       {
        "id": "r4-cart-open",
        "requirement": "R4",
        "description": "The browser ends on the cart page.",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/cart"
         }
        }
       }
      ]
     }
    }
