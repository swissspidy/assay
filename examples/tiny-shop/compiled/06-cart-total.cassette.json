  "sha256:e274018a7cb4f80c8df064d9bb479f2065b41b2da6277b53ebea5c0d0a768076": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_015UXm1MkBr9gESymrNsnskW",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-probe-total",
        "requirement": "R1",
        "description": "The backend cart total is 21.50.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/total"
         },
         "expect": {
          "approx": {
           "value": 21.5,
           "abs": 0.001
          }
         }
        }
       },
       {
        "id": "r1-page-total",
        "requirement": "R1",
        "description": "The cart page's total status shows $21.50.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "node",
          "target": {
           "anchors": [
            {
             "role": "status",
             "name": "Cart total"
            },
            {
             "role": "status",
             "within": {
              "role": "region",
              "name": "Cart summary"
             }
            }
           ]
          },
          "field": "text"
         },
         "normalize": [
          {
           "op": "currency",
           "locale": "en-US",
           "currency": "USD"
          }
         ],
         "expect": {
          "approx": {
           "value": {
            "amount": 21.5,
            "currency": "USD"
           },
           "abs": 0.001
          }
         }
        }
       },
       {
        "id": "r2-blue-mug",
        "requirement": "R2",
        "description": "The backend cart holds exactly one Blue Mug (MUG-BLUE, qty 1).",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "sku": {
              "const": "MUG-BLUE"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "sku",
             "qty"
            ]
           },
           "not": {
            "contains": {
             "type": "object",
             "properties": {
              "sku": {
               "const": "MUG-BLUE"
              },
              "qty": {
               "not": {
                "const": 1
               }
              }
             },
             "required": [
              "sku"
             ]
            }
           }
          }
         }
        }
       },
       {
        "id": "r3-red-mug",
        "requirement": "R3",
        "description": "The backend cart holds exactly one Red Mug (MUG-RED, qty 1).",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "sku": {
              "const": "MUG-RED"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "sku",
             "qty"
            ]
           },
           "not": {
            "contains": {
             "type": "object",
             "properties": {
              "sku": {
               "const": "MUG-RED"
              },
              "qty": {
               "not": {
                "const": 1
               }
              }
             },
             "required": [
              "sku"
             ]
            }
           }
          }
         }
        }
       },
       {
        "id": "r4-cart-url",
        "requirement": "R4",
        "description": "The browser ends on the /cart page.",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/cart"
         }
        }
       },
       {
        "id": "r4-cart-heading",
        "requirement": "R4",
        "description": "The page shows the 'Your cart' heading in main.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "main"
         },
         "match": {
          "role": "heading",
          "name": "Your cart",
          "level": 1
         }
        }
       }
      ]
     }
    }
   ],
