          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "name": {
              "const": "Red Mug"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "name",
             "qty"
            ]
           }
          }
         }
        }
       },
       {
        "id": "r4-cart-page",
        "requirement": "R4",
        "description": "The browser is on the cart page (/cart).",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/cart"
         }
        }
       }
      ]
     }
    }
