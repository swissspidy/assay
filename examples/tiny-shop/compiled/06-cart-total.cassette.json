  "sha256:a7d87a7f79d0c5505824946b0028be9a086adc45fb239fc4355d3427af701ce0": {
   "stop": "tool_use",
   "text": "",
   "toolCalls": [
    {
     "id": "toolu_01B61VgNoRkZrXEzoW2pCoG6",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-total-backend",
        "requirement": "R1",
        "description": "The backend cart total is 21.50.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/total"
         },
         "expect": {
          "approx": {
           "value": 21.5,
           "abs": 0.001
          }
         }
        }
       },
       {
        "id": "r1-total-page",
        "requirement": "R1",
        "description": "The cart page's 'Cart total' status shows $21.50.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "node",
          "target": {
           "anchors": [
            {
             "role": "status",
             "name": "Cart total"
            },
            {
             "role": "status",
             "within": {
              "role": "region",
              "name": "Cart summary"
             }
            }
           ]
          },
          "field": "text"
         },
         "normalize": [
          {
           "op": "currency",
           "locale": "en-US",
           "currency": "USD"
          }
         ],
         "expect": {
          "approx": {
           "value": {
            "amount": 21.5,
            "currency": "USD"
           },
           "abs": 0.001
          }
         }
        }
       },
       {
        "id": "r2-blue-mug",
        "requirement": "R2",
        "description": "The backend cart holds a Blue Mug line with quantity 1.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "sku": {
              "const": "MUG-BLUE"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "sku",
             "qty"
            ]
           }
          }
         }
        }
       },
       {
        "id": "r3-red-mug",
        "requirement": "R3",
        "description": "The backend cart holds a Red Mug line with quantity 1.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "sku": {
              "const": "MUG-RED"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "sku",
             "qty"
            ]
           }
          }
         }
        }
       },
       {
        "id": "r4-cart-open",
        "requirement": "R4",
        "description": "The browser ends on the /cart page showing the 'Your cart' heading.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/cart"
           }
          },
          {
           "kind": "contains",
           "scope": {
            "role": "main"
           },
           "match": {
            "role": "heading",
            "name": "Your cart",
            "level": 1
           }
          }
         ]
        }
       }
      ]
     }
    }
