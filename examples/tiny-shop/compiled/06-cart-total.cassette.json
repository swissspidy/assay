    {
     "id": "toolu_01VyUTNRVMeN2MRG8VpNzovo",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "R1-total-probe",
        "requirement": "R1",
        "description": "The backend cart total is 21.50 and the cart page's total status shows $21.50.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "probe",
            "probe": "cart",
            "pointer": "/total"
           },
           "expect": {
            "approx": {
             "value": 21.5,
             "abs": 0.001
            }
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "node",
            "target": {
             "anchors": [
              {
               "role": "status",
               "name": "Cart total"
              },
              {
               "role": "status",
               "within": {
                "role": "region",
                "name": "Cart summary"
               }
              }
             ]
            },
            "field": "text"
           },
           "normalize": [
            {
             "op": "currency",
             "locale": "en-US",
             "currency": "USD"
            }
           ],
           "expect": {
            "approx": {
             "value": {
              "amount": 21.5,
              "currency": "USD"
             },
             "abs": 0.001
            }
           }
          }
         ]
        }
       },
       {
        "id": "R2-blue-mug",
        "requirement": "R2",
        "description": "The backend cart holds a Blue Mug line with quantity 1.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "name": {
              "const": "Blue Mug"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "name",
             "qty"
            ]
           }
          }
         }
        }
       },
       {
        "id": "R3-red-mug",
        "requirement": "R3",
        "description": "The backend cart holds a Red Mug line with quantity 1.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/items"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "name": {
              "const": "Red Mug"
             },
             "qty": {
              "const": 1
             }
            },
            "required": [
             "name",
             "qty"
            ]
           }
          }
         }
        }
       },
       {
        "id": "R4-cart-open",
        "requirement": "R4",
        "description": "The browser ends on the /cart page.",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/cart"
         }
        }
       }
      ]
     }
    }
