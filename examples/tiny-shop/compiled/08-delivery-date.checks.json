{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/08-delivery-date",
  "version": "1",
  "task": {
    "instruction": "Place an order for my cart with express shipping and show me the estimated delivery date.",
    "outcomes": "Then the confirmation shows an estimated delivery of 5 November 2026"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The order confirmation shows an estimated delivery date of 5 November 2026.",
      "source": {
        "field": "outcomes",
        "quote": "the confirmation shows an estimated delivery of 5 November 2026"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "An order is placed for the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Place an order for my cart"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The order uses express shipping.",
      "source": {
        "field": "instruction",
        "quote": "with express shipping"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-delivery-date",
      "requirement": "R1",
      "description": "The order summary on the confirmation page shows an estimated delivery date of 5 November 2026.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "text",
          "scope": {
            "role": "region",
            "name": "Order summary"
          },
          "pattern": "Estimated delivery:\\s*([^\\n]*?)\\s*(?:\\n|Total:|$)",
          "group": 1
        },
        "normalize": [
          {
            "op": "date",
            "locale": "en-GB"
          }
        ],
        "expect": {
          "equals": "2026-11-05"
        }
      }
    },
    {
      "id": "r1-confirmation-page",
      "requirement": "R1",
      "description": "The browser is on the confirmation page of the order just placed (URL /orders/<id> matching the latest order id).",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/orders/*"
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "url",
              "part": "pathname"
            },
            "normalize": [
              {
                "op": "extract",
                "regex": "^/orders/([^/]+)/?$",
                "group": 1
              }
            ],
            "expect": {
              "sameAs": {
                "source": {
                  "from": "probe",
                  "probe": "latestOrder",
                  "pointer": "/id"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "r2-order-request",
      "requirement": "R2",
      "description": "A POST to /api/orders succeeded.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        }
      }
    },
    {
      "id": "r2-order-items-match-cart",
      "requirement": "R2",
      "description": "The latest order's items are exactly the cart items from before the task.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
        },
        "normalize": [
          {
            "op": "items"
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
            },
            "normalize": [
              {
                "op": "items"
              }
            ]
          }
        }
      }
    },
    {
      "id": "r3-express-shipping",
      "requirement": "R3",
      "description": "The latest order stored by the backend uses express shipping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
        },
        "expect": {
          "equals": "express"
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T07:44:39.498Z"
  }
}
