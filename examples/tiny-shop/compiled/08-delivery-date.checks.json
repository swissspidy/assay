{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/08-delivery-date",
  "version": "1",
  "task": {
    "instruction": "Place an order for my cart with express shipping and show me the estimated delivery date.",
    "outcomes": "Then the confirmation shows an estimated delivery of 5 November 2026"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The order confirmation shows an estimated delivery date of 5 November 2026.",
      "source": {
        "field": "outcomes",
        "quote": "the confirmation shows an estimated delivery of 5 November 2026"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "An order is placed for the items in the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Place an order for my cart"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "Express shipping is selected for the order.",
      "source": {
        "field": "instruction",
        "quote": "with express shipping"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "The user is shown the estimated delivery date.",
      "source": {
        "field": "instruction",
        "quote": "show me the estimated delivery date"
      }
    }
  ],
  "checks": [
    {
      "id": "R1-confirmation-date",
      "requirement": "R1",
      "description": "The order confirmation's 'Estimated delivery' line shows the date 5 November 2026.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "node",
          "target": {
            "anchors": [
              {
                "role": "paragraph",
                "text": {
                  "contains": "Estimated delivery",
                  "ignoreCase": true
                },
                "within": {
                  "role": "region",
                  "name": {
                    "contains": "Order"
                  }
                }
              },
              {
                "role": "paragraph",
                "text": {
                  "contains": "Estimated delivery",
                  "ignoreCase": true
                },
                "within": {
                  "role": "main"
                }
              }
            ]
          },
          "field": "text"
        },
        "normalize": [
          {
            "op": "extract",
            "regex": "delivery\\s*:?\\s*(.+)$",
            "flags": "i",
            "group": 1
          },
          "trim",
          {
            "op": "date",
            "locale": "en-GB"
          }
        ],
        "expect": {
          "equals": "2026-11-05"
        }
      }
    },
    {
      "id": "R2-order-request",
      "requirement": "R2",
      "description": "A POST to /api/orders succeeded and returned a placed order containing at least one item.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          },
          "responseBody": {
            "type": "object",
            "required": [
              "status",
              "items"
            ],
            "properties": {
              "status": {
                "const": "placed"
              },
              "items": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "id": "R2-order-probe",
      "requirement": "R2",
      "description": "The backend's latest order has status 'placed' and contains at least one item.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder"
        },
        "expect": {
          "schema": {
            "type": "object",
            "required": [
              "status",
              "items"
            ],
            "properties": {
              "status": {
                "const": "placed"
              },
              "items": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "id": "R3-express-probe",
      "requirement": "R3",
      "description": "The backend's latest placed order uses express shipping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder"
        },
        "expect": {
          "schema": {
            "type": "object",
            "required": [
              "status",
              "shipping"
            ],
            "properties": {
              "status": {
                "const": "placed"
              },
              "shipping": {
                "type": "string",
                "pattern": "^[Ee][Xx][Pp][Rr][Ee][Ss][Ss]$"
              }
            }
          }
        }
      }
    },
    {
      "id": "R3-express-request",
      "requirement": "R3",
      "description": "The order submission request sent express as the shipping method.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "request",
          "match": {
            "method": "POST",
            "url": {
              "path": "/api/orders"
            },
            "status": {
              "gte": 200,
              "lt": 300
            }
          },
          "pick": "last",
          "pointer": "/shipping"
        },
        "normalize": [
          "trim",
          "lowercase"
        ],
        "expect": {
          "equals": "express"
        }
      }
    },
    {
      "id": "R4-delivery-shown",
      "requirement": "R4",
      "description": "The order confirmation page displays an 'Estimated delivery' line containing a date.",
      "assert": {
        "kind": "contains",
        "scope": {
          "anchors": [
            {
              "role": "main"
            }
          ]
        },
        "match": {
          "role": "paragraph",
          "text": {
            "regex": "estimated delivery\\s*:?\\s*\\S+",
            "flags": "i"
          }
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-04T10:10:58.960Z"
  }
}
