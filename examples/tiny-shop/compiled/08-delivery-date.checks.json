{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/08-delivery-date",
  "version": "1",
  "task": {
    "instruction": "Place an order for my cart with express shipping and show me the estimated delivery date.",
    "outcomes": "Then the confirmation shows an estimated delivery of 5 November 2026"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "An order is placed for the items in the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Place an order for my cart"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The order uses express shipping.",
      "source": {
        "field": "instruction",
        "quote": "with express shipping"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The order confirmation shows an estimated delivery date of 5 November 2026.",
      "source": {
        "field": "outcomes",
        "quote": "the confirmation shows an estimated delivery of 5 November 2026"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "The estimated delivery date is shown to the user.",
      "source": {
        "field": "instruction",
        "quote": "show me the estimated delivery date"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-order-request",
      "requirement": "R1",
      "description": "A POST to /api/orders succeeded with a placed order.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        }
      }
    },
    {
      "id": "r1-order-items-match-cart",
      "requirement": "R1",
      "description": "The latest order's items (sku and qty) equal the cart's items before the task.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
        },
        "normalize": [
          {
            "op": "items",
            "pick": [
              "/sku",
              "/qty"
            ]
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
            },
            "normalize": [
              {
                "op": "items",
                "pick": [
                  "/sku",
                  "/qty"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "r2-express-probe",
      "requirement": "R2",
      "description": "The latest order stored by the backend uses express shipping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
        },
        "expect": {
          "equals": "express"
        }
      }
    },
    {
      "id": "r3-probe-delivery",
      "requirement": "R3",
      "description": "The latest order's estimated delivery is 2026-11-05.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/estimatedDelivery"
        },
        "normalize": [
          "trim"
        ],
        "expect": {
          "equals": "2026-11-05"
        }
      }
    },
    {
      "id": "r3-confirmation-page",
      "requirement": "R3",
      "description": "The current page is the confirmation page of the latest order.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "url",
          "part": "pathname"
        },
        "normalize": [
          {
            "op": "extract",
            "regex": "^/orders/([^/]+)/?$",
            "group": 1
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "r3-page-shows-date",
      "requirement": "R3",
      "description": "The order summary shows an estimated delivery date of 5 November 2026.",
      "assert": {
        "kind": "each",
        "scope": {
          "anchors": [
            {
              "role": "region",
              "name": "Order summary"
            },
            {
              "role": "region",
              "landmark": {
                "role": "main"
              }
            }
          ]
        },
        "witness": {
          "role": "paragraph",
          "text": {
            "contains": "Estimated delivery",
            "ignoreCase": true
          }
        },
        "match": {
          "role": "paragraph",
          "text": {
            "contains": "Estimated delivery",
            "ignoreCase": true
          }
        },
        "count": {
          "eq": 1
        },
        "assert": {
          "kind": "value",
          "source": {
            "from": "text",
            "pattern": "Estimated delivery\\s*:?\\s*(.+?)\\s*$",
            "flags": "i",
            "group": 1
          },
          "normalize": [
            {
              "op": "date",
              "locale": "en-GB"
            }
          ],
          "expect": {
            "equals": "2026-11-05"
          }
        }
      }
    },
    {
      "id": "r4-page-date-matches-order",
      "requirement": "R4",
      "description": "The estimated delivery date shown on the page equals the order's estimated delivery stored by the backend.",
      "assert": {
        "kind": "each",
        "scope": {
          "anchors": [
            {
              "role": "region",
              "name": "Order summary"
            },
            {
              "role": "region",
              "landmark": {
                "role": "main"
              }
            }
          ]
        },
        "witness": {
          "role": "paragraph",
          "text": {
            "contains": "Estimated delivery",
            "ignoreCase": true
          }
        },
        "match": {
          "role": "paragraph",
          "text": {
            "contains": "Estimated delivery",
            "ignoreCase": true
          }
        },
        "count": {
          "eq": 1
        },
        "assert": {
          "kind": "value",
          "source": {
            "from": "text",
            "pattern": "Estimated delivery\\s*:?\\s*(.+?)\\s*$",
            "flags": "i",
            "group": 1
          },
          "normalize": [
            {
              "op": "date",
              "locale": "en-GB"
            }
          ],
          "expect": {
            "sameAs": {
              "source": {
                "from": "probe",
                "probe": "latestOrder",
                "pointer": "/estimatedDelivery"
              },
              "normalize": [
                {
                  "op": "date",
                  "locale": "en-GB"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T10:43:04.726Z"
  }
}
