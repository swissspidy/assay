{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/08-delivery-date",
  "version": "1",
  "task": {
    "instruction": "Place an order for my cart with express shipping and show me the estimated delivery date.",
    "outcomes": "Then the confirmation shows an estimated delivery of 5 November 2026"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The order confirmation shows an estimated delivery date of 5 November 2026.",
      "source": {
        "field": "outcomes",
        "quote": "the confirmation shows an estimated delivery of 5 November 2026"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "An order is placed for the items in the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Place an order for my cart"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The order uses express shipping.",
      "source": {
        "field": "instruction",
        "quote": "with express shipping"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "The estimated delivery date is reported to the user.",
      "source": {
        "field": "instruction",
        "quote": "show me the estimated delivery date"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-confirmation-delivery-date",
      "requirement": "R1",
      "description": "The order confirmation page (/orders/:id) for the latest order shows an estimated delivery date of 5 November 2026 in its Order summary.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/orders/*"
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "text",
              "scope": {
                "role": "region",
                "name": "Order summary"
              },
              "pattern": "Estimated delivery:?\\s*(\\d{4}-\\d{2}-\\d{2}|[^\\n]*?\\d{4})",
              "group": 1
            },
            "normalize": [
              "trim",
              {
                "op": "date",
                "locale": "en"
              }
            ],
            "expect": {
              "equals": "2026-11-05"
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "text",
              "scope": {
                "role": "region",
                "name": "Order summary"
              },
              "pattern": "Order number:?\\s*([A-Za-z0-9-]+)",
              "group": 1
            },
            "expect": {
              "sameAs": {
                "source": {
                  "from": "probe",
                  "probe": "latestOrder",
                  "pointer": "/id"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "r1-stored-delivery-date",
      "requirement": "R1",
      "description": "The stored latest order has estimated delivery 2026-11-05.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/estimatedDelivery"
        },
        "expect": {
          "equals": "2026-11-05"
        }
      }
    },
    {
      "id": "r2-order-request",
      "requirement": "R2",
      "description": "A POST to /api/orders succeeded.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        }
      }
    },
    {
      "id": "r2-order-placed",
      "requirement": "R2",
      "description": "The latest order has status placed.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/status"
        },
        "expect": {
          "equals": "placed"
        }
      }
    },
    {
      "id": "r2-order-items-match-cart",
      "requirement": "R2",
      "description": "The latest order's items are exactly the cart's items before the task.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
        },
        "normalize": [
          {
            "op": "items"
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
            },
            "normalize": [
              {
                "op": "items"
              }
            ]
          }
        }
      }
    },
    {
      "id": "r3-express-shipping",
      "requirement": "R3",
      "description": "The stored latest order uses express shipping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
        },
        "expect": {
          "equals": "express"
        }
      }
    },
    {
      "id": "r4-delivery-date-shown",
      "requirement": "R4",
      "description": "The page shows the order's estimated delivery date, matching the date stored on the latest order.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "text",
          "scope": {
            "role": "region",
            "name": "Order summary"
          },
          "pattern": "Estimated delivery:?\\s*(\\d{4}-\\d{2}-\\d{2}|[^\\n]*?\\d{4})",
          "group": 1
        },
        "normalize": [
          "trim",
          {
            "op": "date",
            "locale": "en"
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "latestOrder",
              "pointer": "/estimatedDelivery"
            },
            "normalize": [
              {
                "op": "date",
                "locale": "en"
              }
            ]
          }
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T11:30:31.341Z"
  }
}
