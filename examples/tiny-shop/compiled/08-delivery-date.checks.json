{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/08-delivery-date",
  "version": "1",
  "task": {
    "instruction": "Place an order for my cart with express shipping and show me the estimated delivery date.",
    "outcomes": "Then the confirmation shows an estimated delivery of 5 November 2026"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The order confirmation shows an estimated delivery date of 5 November 2026.",
      "source": {
        "field": "outcomes",
        "quote": "the confirmation shows an estimated delivery of 5 November 2026"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "An order is placed for the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "Place an order for my cart"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "Express shipping is selected for the order.",
      "source": {
        "field": "instruction",
        "quote": "with express shipping"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-confirmation-page",
      "requirement": "R1",
      "description": "The browser is on the order confirmation page for the latest order.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/orders/*"
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "url",
              "part": "pathname"
            },
            "normalize": [
              {
                "op": "extract",
                "regex": "^/orders/([^/]+)/?$",
                "group": 1
              }
            ],
            "expect": {
              "sameAs": {
                "source": {
                  "from": "probe",
                  "probe": "latestOrder",
                  "pointer": "/id"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "r1-delivery-date-shown",
      "requirement": "R1",
      "description": "The order summary on the confirmation shows an estimated delivery date of 5 November 2026.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "text",
          "scope": {
            "anchors": [
              {
                "role": "region",
                "name": {
                  "contains": "Order summary",
                  "ignoreCase": true
                }
              }
            ]
          },
          "pattern": "Estimated delivery:?\\s*([^\\n]+?)\\s*(?:Total|$|\\n)",
          "flags": "i",
          "group": 1
        },
        "normalize": [
          "trim",
          {
            "op": "date",
            "locale": "en-GB"
          }
        ],
        "expect": {
          "equals": "2026-11-05"
        }
      }
    },
    {
      "id": "r1-delivery-date-backend",
      "requirement": "R1",
      "description": "The placed order's estimated delivery recorded by the backend is 2026-11-05.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/estimatedDelivery"
        },
        "expect": {
          "equals": "2026-11-05"
        }
      }
    },
    {
      "id": "r2-order-request",
      "requirement": "R2",
      "description": "A POST to /api/orders succeeded.",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        },
        "count": {
          "gte": 1
        }
      }
    },
    {
      "id": "r2-order-items-match-cart",
      "requirement": "R2",
      "description": "The latest order's items (sku and qty) are exactly the items that were in the cart before the task.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
        },
        "normalize": [
          {
            "op": "items",
            "pointer": "/sku"
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
            },
            "normalize": [
              {
                "op": "items",
                "pointer": "/sku"
              }
            ]
          }
        }
      }
    },
    {
      "id": "r2-order-qty-match-cart",
      "requirement": "R2",
      "description": "The latest order's item quantities match the cart before the task.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/items"
        },
        "normalize": [
          {
            "op": "items",
            "pointer": "/qty"
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "cart",
              "pointer": "/items",
              "at": "before"
            },
            "normalize": [
              {
                "op": "items",
                "pointer": "/qty"
              }
            ]
          }
        }
      }
    },
    {
      "id": "r3-express-backend",
      "requirement": "R3",
      "description": "The latest order stored by the backend uses express shipping.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "latestOrder",
          "pointer": "/shipping"
        },
        "expect": {
          "equals": "express"
        }
      }
    },
    {
      "id": "r3-express-request",
      "requirement": "R3",
      "description": "The order request was sent with shipping set to express.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "request",
          "match": {
            "method": "POST",
            "url": {
              "path": "/api/orders"
            },
            "status": {
              "gte": 200,
              "lt": 300
            }
          },
          "pick": "last",
          "pointer": "/shipping"
        },
        "expect": {
          "equals": "express"
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T06:57:19.401Z"
  }
}
