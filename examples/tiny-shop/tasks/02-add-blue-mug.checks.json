{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/add-blue-mug",
  "version": "1",
  "task": {
    "instruction": "Add a Blue Mug to my cart.",
    "outcomes": "Then the cart contains a Blue Mug"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The cart contains a Blue Mug",
      "source": { "field": "outcomes", "quote": "the cart contains a Blue Mug" }
    }
  ],
  "checks": [
    {
      "id": "C1",
      "requirement": "R1",
      "description": "The backend cart (probe 'cart') has a line item named Blue Mug.",
      "assert": {
        "kind": "value",
        "source": { "from": "probe", "probe": "cart", "pointer": "/items" },
        "expect": {
          "schema": {
            "type": "array",
            "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "Blue Mug" } } }
          }
        }
      }
    }
  ]
}
