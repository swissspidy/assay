{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/set-quantity",
  "version": "1",
  "task": {
    "instruction": "Change the quantity of the Blue Mug in my cart to 3.",
    "outcomes": "Then the cart shows 3 Blue Mugs"
  },
  "requirements": [
    { "id": "R1", "kind": "hard", "text": "The Blue Mug quantity is 3",
      "source": { "field": "instruction", "quote": "quantity of the Blue Mug in my cart to 3" } }
  ],
  "checks": [
    { "id": "C1", "requirement": "R1",
      "description": "The quantity field for Blue Mug in the Cart table reads 3.",
      "assert": { "kind": "value",
        "source": { "from": "node", "field": "value", "target": { "anchors": [
          { "role": "spinbutton", "name": "Quantity for Blue Mug" },
          { "role": "spinbutton", "within": { "role": "row", "name": { "contains": "Blue Mug" } } }
        ] } },
        "normalize": [ { "op": "number", "locale": "en-US" } ],
        "expect": { "equals": 3 } } }
  ]
}
