{
  "schema": "assay.checks/v1",
  "id": "tiny-calendar/timezone",
  "version": "1",
  "task": {
    "instruction": "Set my calendar's time zone to Berlin.",
    "outcomes": "Then the time zone setting is Berlin"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The time zone setting is Berlin",
      "source": {
        "field": "outcomes",
        "quote": "the time zone setting is Berlin"
      }
    }
  ],
  "checks": [
    {
      "id": "C1",
      "requirement": "R1",
      "description": "The settings were saved (PUT /api/settings \u2192 200).",
      "assert": {
        "kind": "request",
        "match": {
          "method": "PUT",
          "url": {
            "path": "/api/settings"
          },
          "status": 200
        }
      }
    },
    {
      "id": "C2",
      "requirement": "R1",
      "description": "The backend's time zone setting is Europe/Berlin.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "settings",
          "pointer": "/timezone"
        },
        "expect": {
          "equals": "Europe/Berlin"
        }
      }
    }
  ]
}
