{
  "schema": "assay.checks/v1",
  "id": "tiny-calendar/lunch",
  "version": "1",
  "task": {
    "instruction": "Add \"Lunch with Sam\" to my calendar on November 5, 2026 at 12:30.",
    "outcomes": "Then an event \"Lunch with Sam\" exists on November 5, 2026 at 12:30\nThen the event page shows the date November 5, 2026"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "An event \"Lunch with Sam\" exists on November 5, 2026 at 12:30",
      "source": {
        "field": "outcomes",
        "quote": "an event \"Lunch with Sam\" exists on November 5, 2026 at 12:30"
      }
    },
    {
      "id": "R2",
      "kind": "soft",
      "text": "The event page shows the date November 5, 2026",
      "source": {
        "field": "outcomes",
        "quote": "the event page shows the date November 5, 2026"
      }
    }
  ],
  "checks": [
    {
      "id": "C1",
      "requirement": "R1",
      "description": "The event was created (POST /api/events \u2192 201).",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/events"
          },
          "status": 201
        }
      }
    },
    {
      "id": "C2",
      "requirement": "R1",
      "description": "The backend has \"Lunch with Sam\" on 2026-11-05 at 12:30.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "events"
        },
        "expect": {
          "schema": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["title", "date", "time"],
              "properties": {
                "title": {
                  "const": "Lunch with Sam"
                },
                "date": {
                  "const": "2026-11-05"
                },
                "time": {
                  "const": "12:30"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "C3",
      "requirement": "R2",
      "description": "The event details pair the term \"When\" with a date of 2026-11-05 (any date format).",
      "assert": {
        "kind": "each",
        "scope": {
          "role": "main"
        },
        "match": {
          "role": "term",
          "text": "When"
        },
        "count": {
          "eq": 1
        },
        "assert": {
          "kind": "value",
          "source": {
            "from": "node",
            "target": {
              "role": "definition"
            },
            "field": "text"
          },
          "normalize": [
            {
              "op": "replace",
              "regex": ",? \\d{1,2}:\\d{2}( ?[AP]M)?$",
              "flags": "i",
              "with": ""
            },
            {
              "op": "date",
              "locale": "en-US"
            }
          ],
          "expect": {
            "equals": "2026-11-05"
          }
        }
      }
    },
    {
      "id": "C4",
      "requirement": "R2",
      "description": "The page shown is the event page of \"Lunch with Sam\": an /events/<id> URL whose main heading is exactly the title.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/events/*"
            }
          },
          {
            "kind": "state",
            "target": {
              "role": "heading",
              "level": 1,
              "within": {
                "role": "main"
              }
            },
            "expect": {
              "name": {
                "equals": "Lunch with Sam"
              }
            }
          }
        ]
      }
    }
  ]
}
