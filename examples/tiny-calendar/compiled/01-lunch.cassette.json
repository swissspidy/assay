       {
        "id": "R1-probe-event",
        "requirement": "R1",
        "description": "The backend events list contains an event titled \"Lunch with Sam\" on 2026-11-05 at 12:30.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "events"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
