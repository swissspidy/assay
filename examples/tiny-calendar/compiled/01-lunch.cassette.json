          }
         }
        }
       },
       {
        "id": "R2-event-page",
        "requirement": "R2",
        "description": "The current page is an event page (/events/<id>) whose level-1 heading is \"Lunch with Sam\".",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
