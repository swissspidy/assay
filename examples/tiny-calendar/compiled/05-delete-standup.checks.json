                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "r2-others-remain",
      "requirement": "R2",
      "description": "The backend events list still contains Dentist (2026-11-06) and Book club (2026-11-10).",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "events"
        },
        "expect": {
          "schema": {
            "type": "array",
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "title",
                    "date"
                  ],
                  "properties": {
                    "title": {
                      "const": "Dentist"
                    },
                    "date": {
                      "const": "2026-11-06"
                    }
