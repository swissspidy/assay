      "assert": {
        "kind": "request",
        "match": {
          "method": "DELETE",
          "url": {
            "path": "/api/events/1"
          },
          "status": {
            "gte": 200,
            "lt": 300
          }
        },
        "count": {
          "gte": 1
        }
      }
    },
    {
      "id": "R2-others-remain",
