        "expect": {
          "schema": {
            "type": "object",
            "properties": {
              "title": {
                "const": "Book club"
              },
              "rsvp": {
                "const": "yes"
              }
            },
            "required": [
              "title",
              "rsvp"
            ]
          }
        }
      }
    }
