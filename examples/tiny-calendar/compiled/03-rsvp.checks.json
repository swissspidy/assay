              ]
            },
            "items": {
              "if": {
                "type": "object",
                "properties": {
                  "title": {
                    "const": "Book club"
                  }
                },
                "required": [
                  "title"
                ]
              },
              "then": {
                "properties": {
                  "rsvp": {
                    "const": "yes"
                  }
                },
                "required": [
                  "rsvp"
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "bookclub-rsvp-request",
      "requirement": "R1",
      "description": "The last RSVP update request for an event was accepted, and the server's reply shows Book club with rsvp yes.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "response",
          "match": {
            "method": "PUT",
            "url": {
              "path": "/api/events/*/rsvp"
            },
            "status": {
              "gte": 200,
              "lt": 300
            }
          },
          "pick": "last"
