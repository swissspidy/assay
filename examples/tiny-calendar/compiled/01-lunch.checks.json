{
  "schema": "assay.checks/v1",
  "id": "tiny-calendar/01-lunch",
  "version": "1",
  "task": {
    "instruction": "Add \"Lunch with Sam\" to my calendar on November 5, 2026 at 12:30.",
    "outcomes": "Then an event \"Lunch with Sam\" exists on November 5, 2026 at 12:30\nThen the event page shows the date November 5, 2026"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "An event titled \"Lunch with Sam\" exists on November 5, 2026 at 12:30.",
      "source": {
        "field": "outcomes",
        "quote": "an event \"Lunch with Sam\" exists on November 5, 2026 at 12:30"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The event page shows the date November 5, 2026.",
      "source": {
        "field": "outcomes",
        "quote": "the event page shows the date November 5, 2026"
      }
    }
  ],
  "checks": [
    {
      "id": "R1-probe-event",
      "requirement": "R1",
      "description": "The backend events list contains an event titled \"Lunch with Sam\" on 2026-11-05 at 12:30.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "events"
        },
        "expect": {
          "schema": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "title",
                "date",
                "time"
              ],
              "properties": {
                "title": {
                  "const": "Lunch with Sam"
                },
                "date": {
                  "const": "2026-11-05"
                },
                "time": {
                  "const": "12:30"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "R2-event-page",
      "requirement": "R2",
      "description": "The current page is an event page (/events/<id>) whose level-1 heading is \"Lunch with Sam\".",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/events/*"
            }
          },
          {
            "kind": "state",
            "target": {
              "anchors": [
                {
                  "role": "heading",
                  "level": 1,
                  "within": {
                    "role": "main"
                  }
                },
                {
                  "role": "heading",
                  "name": "Lunch with Sam",
                  "level": 1
                }
              ]
            },
            "expect": {
              "name": {
                "equals": "Lunch with Sam"
              }
            }
          }
        ]
      }
    },
    {
      "id": "R2-when-date",
      "requirement": "R2",
      "description": "The \"When\" field on the event page shows a date on November 5, 2026.",
      "assert": {
        "kind": "each",
        "scope": {
          "role": "main"
        },
        "witness": {
          "role": "term",
          "text": "When"
        },
        "match": {
          "role": "term",
          "text": "When"
        },
        "count": {
          "eq": 1
        },
        "assert": {
          "kind": "value",
          "source": {
            "from": "node",
            "target": {
              "role": "definition"
            },
            "field": "text"
          },
          "normalize": [
            {
              "op": "datetime",
              "locale": "en-US",
              "timezone": "UTC"
            }
          ],
          "expect": {
            "gte": "2026-11-05T00:00:00Z",
            "lt": "2026-11-06T00:00:00Z"
          }
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T11:33:31.569Z"
  }
}
