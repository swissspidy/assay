      "kind": "hard",
      "text": "An event titled \"Lunch with Sam\" exists on November 5, 2026 at 12:30.",
      "source": {
        "field": "outcomes",
        "quote": "an event \"Lunch with Sam\" exists on November 5, 2026 at 12:30"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The event page shows the date November 5, 2026.",
      "source": {
        "field": "outcomes",
        "quote": "the event page shows the date November 5, 2026"
      }
    }
  ],
  "checks": [
    {
      "id": "R1-probe-event",
      "requirement": "R1",
      "description": "The backend events list contains an event titled \"Lunch with Sam\" on 2026-11-05 at 12:30.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "events"
        },
        "expect": {
          "schema": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "title",
                "date",
                "time"
              ],
              "properties": {
                "title": {
                  "const": "Lunch with Sam"
                },
                "date": {
                  "const": "2026-11-05"
                },
                "time": {
                  "const": "12:30"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "R2-event-page",
      "requirement": "R2",
      "description": "The browser is on an event detail page (/events/:id) whose heading is \"Lunch with Sam\".",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/events/*"
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "heading",
              "level": 1,
              "name": {
                "contains": "Lunch with Sam"
              }
            }
          }
        ]
      }
    },
    {
      "id": "R2-shows-date",
      "requirement": "R2",
      "description": "The event page's 'When' value shows the date November 5, 2026.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "node",
          "target": {
            "role": "definition",
            "within": {
              "role": "main"
            },
            "text": {
              "contains": "2026"
            }
          },
          "field": "text"
        },
        "normalize": [
          {
            "op": "extract",
            "regex": "(\\d{4}-\\d{2}-\\d{2}|[A-Za-z]+\\.? \\d{1,2},? \\d{4}|\\d{1,2}\\.? [A-Za-z]+\\.? \\d{4}|\\d{1,2}[/.]\\d{1,2}[/.]\\d{4})",
            "group": 1
          },
          {
            "op": "date",
            "locale": "en-US"
          }
        ],
        "expect": {
          "equals": "2026-11-05"
        }
      }
