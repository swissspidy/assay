{
  "schema": "assay.checks/v1",
  "id": "tiny-tracker/10-filter-open-bugs",
  "version": "1",
  "task": {
    "instruction": "Show me only the open bugs in the issue list.",
    "outcomes": "Then the list shows only open issues\nThen the list shows only issues labelled bug"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The issue list shows only open issues.",
      "source": {
        "field": "outcomes",
        "quote": "Then the list shows only open issues"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The issue list shows only issues labelled bug.",
      "source": {
        "field": "outcomes",
        "quote": "Then the list shows only issues labelled bug"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-status-filter-open",
      "requirement": "R1",
      "description": "The issue list URL has the status filter set to open and every listed issue row shows status Open.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/issues",
              "query": {
                "status": {
                  "equals": "open",
                  "ignoreCase": true
                }
              }
            }
          },
          {
            "kind": "each",
            "scope": {
              "role": "table",
              "name": "Issues"
            },
            "witness": {
              "role": "columnheader",
              "name": "Status"
            },
            "match": {
              "role": "row",
              "name": {
                "regex": "^\\d+\\s"
              }
            },
            "assert": {
              "kind": "contains",
              "match": {
                "role": "cell",
                "name": {
                  "equals": "Open",
                  "ignoreCase": true
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "r2-label-filter-bug",
      "requirement": "R2",
      "description": "The issue list URL has the label filter set to bug and every listed issue row carries the bug label.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/issues",
              "query": {
                "label": {
                  "equals": "bug",
                  "ignoreCase": true
                }
              }
            }
          },
          {
            "kind": "each",
            "scope": {
              "role": "table",
              "name": "Issues"
            },
            "witness": {
              "role": "columnheader",
              "name": "Labels"
            },
            "match": {
              "role": "row",
              "name": {
                "regex": "^\\d+\\s"
              }
            },
            "assert": {
              "kind": "contains",
              "match": {
                "role": "cell",
                "name": {
                  "regex": "(^|[\\s,])bug($|[\\s,])",
                  "flags": "i"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T10:45:45.546Z"
  }
}
