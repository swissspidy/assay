{
  "schema": "assay.checks/v1",
  "id": "tiny-tracker/10-filter-open-bugs",
  "version": "1",
  "task": {
    "instruction": "Show me only the open bugs in the issue list.",
    "outcomes": "Then the list shows only open issues\nThen the list shows only issues labelled bug"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The issue list shows only open issues.",
      "source": {
        "field": "outcomes",
        "quote": "Then the list shows only open issues"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The issue list shows only issues labelled bug.",
      "source": {
        "field": "outcomes",
        "quote": "Then the list shows only issues labelled bug"
      }
    }
  ],
  "checks": [
    {
      "id": "R1-open-filter",
      "requirement": "R1",
      "description": "The issue list URL has status=open and the Issues table shows no Closed issue.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/issues",
              "query": {
                "status": {
                  "equals": "open",
                  "ignoreCase": true
                }
              }
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "table",
              "name": "Issues",
              "landmark": {
                "role": "main"
              }
            },
            "witness": {
              "role": "columnheader",
              "name": "Status"
            },
            "match": {
              "role": "cell",
              "name": {
                "equals": "Closed",
                "ignoreCase": true
              }
            },
            "count": {
              "eq": 0
            }
          }
        ]
      }
    },
    {
      "id": "R2-bug-filter",
      "requirement": "R2",
      "description": "The issue list URL has label=bug and the Issues table shows none of the non-bug issues (Add dark mode, Typo in docs).",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/issues",
              "query": {
                "label": {
                  "equals": "bug",
                  "ignoreCase": true
                }
              }
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "table",
              "name": "Issues",
              "landmark": {
                "role": "main"
              }
            },
            "witness": {
              "role": "columnheader",
              "name": "Labels"
            },
            "match": {
              "role": "row",
              "name": {
                "regex": "Add dark mode|Typo in docs"
              }
            },
            "count": {
              "eq": 0
            }
          }
        ]
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T07:44:38.292Z"
  }
}
