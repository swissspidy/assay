{
  "schema": "assay.checks/v1",
  "id": "tiny-tracker/10-filter-open-bugs",
  "version": "1",
  "task": {
    "instruction": "Show me only the open bugs in the issue list.",
    "outcomes": "Then the list shows only open issues\nThen the list shows only issues labelled bug"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The issue list shows only open issues.",
      "source": {
        "field": "outcomes",
        "quote": "the list shows only open issues"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The issue list shows only issues labelled bug.",
      "source": {
        "field": "outcomes",
        "quote": "the list shows only issues labelled bug"
      }
    }
  ],
  "checks": [
    {
      "id": "R1-open-filter",
      "requirement": "R1",
      "description": "The issue list view is filtered to status open: the URL carries status=open and the Status filter has Open selected.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/issues",
              "query": {
                "status": {
                  "equals": "open",
                  "ignoreCase": true
                }
              }
            }
          },
          {
            "kind": "state",
            "target": {
              "role": "option",
              "name": "Open",
              "within": {
                "role": "combobox",
                "name": "Status"
              }
            },
            "expect": {
              "selected": true
            }
          }
        ]
      }
    },
    {
      "id": "R2-bug-filter",
      "requirement": "R2",
      "description": "The issue list view is filtered to label bug: the URL carries label=bug and the Label filter has bug selected.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/issues",
              "query": {
                "label": {
                  "equals": "bug",
                  "ignoreCase": true
                }
              }
            }
          },
          {
            "kind": "state",
            "target": {
              "role": "option",
              "name": "bug",
              "within": {
                "role": "combobox",
                "name": "Label"
              }
            },
            "expect": {
              "selected": true
            }
          }
        ]
      }
    }
  ],
