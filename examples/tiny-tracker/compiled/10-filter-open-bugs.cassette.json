    {
     "id": "toolu_0133ndv1qjWEEDQabiAgv8Su",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-status-filter-open",
        "requirement": "R1",
        "description": "The issue list URL has the status filter set to open and every listed issue row shows status Open.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/issues",
            "query": {
             "status": {
              "equals": "open",
              "ignoreCase": true
             }
            }
           }
          },
          {
           "kind": "each",
           "scope": {
            "role": "table",
            "name": "Issues"
           },
           "witness": {
            "role": "columnheader",
            "name": "Status"
           },
           "match": {
            "role": "row",
            "name": {
             "regex": "^\\d+\\s"
            }
           },
           "assert": {
            "kind": "contains",
            "match": {
             "role": "cell",
             "name": {
              "equals": "Open",
              "ignoreCase": true
             }
            }
           }
          }
         ]
        }
       },
       {
        "id": "r2-label-filter-bug",
        "requirement": "R2",
        "description": "The issue list URL has the label filter set to bug and every listed issue row carries the bug label.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/issues",
            "query": {
             "label": {
              "equals": "bug",
              "ignoreCase": true
             }
            }
           }
          },
          {
           "kind": "each",
           "scope": {
            "role": "table",
            "name": "Issues"
           },
           "witness": {
            "role": "columnheader",
            "name": "Labels"
           },
           "match": {
            "role": "row",
            "name": {
             "regex": "^\\d+\\s"
            }
           },
           "assert": {
            "kind": "contains",
            "match": {
             "role": "cell",
             "name": {
              "regex": "(^|[\\s,])bug($|[\\s,])",
              "flags": "i"
             }
            }
           }
          }
         ]
        }
       }
      ]
     }
    }
