   "toolCalls": [
    {
     "id": "toolu_01PKZ1Yph35mUpSgLpbzhQYz",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-status-filter",
        "requirement": "R1",
        "description": "The status filter is set to Open (URL status=open or the Status dropdown shows Open selected).",
        "assert": {
         "kind": "anyOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "query": {
             "status": {
              "equals": "open",
              "ignoreCase": true
             }
            }
           }
          },
          {
           "kind": "state",
           "target": {
            "role": "option",
            "name": "Open",
            "within": {
             "role": "combobox",
             "name": "Status"
            }
           },
           "expect": {
            "selected": true
           }
          }
         ]
        }
       },
       {
        "id": "r1-no-closed-rows",
        "requirement": "R1",
        "description": "The issues table contains no row whose status cell is Closed.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "table",
          "name": "Issues"
         },
         "witness": {
          "role": "columnheader",
          "name": "Status"
         },
         "match": {
          "role": "cell",
          "name": {
           "equals": "Closed",
           "ignoreCase": true
          }
         },
         "count": {
          "eq": 0
         }
        }
       },
       {
        "id": "r2-label-filter",
        "requirement": "R2",
        "description": "The label filter is set to bug (URL label=bug or the Label dropdown shows bug selected).",
        "assert": {
         "kind": "anyOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "query": {
             "label": {
              "equals": "bug",
              "ignoreCase": true
             }
            }
           }
          },
          {
           "kind": "state",
           "target": {
            "role": "option",
            "name": "bug",
            "within": {
             "role": "combobox",
             "name": "Label"
            }
           },
           "expect": {
            "selected": true
           }
          }
         ]
        }
       },
       {
        "id": "r2-no-nonbug-rows",
        "requirement": "R2",
        "description": "The issues table shows no rows for the non-bug issues 'Add dark mode' or 'Typo in docs'.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "table",
          "name": "Issues"
         },
         "witness": {
          "role": "columnheader",
          "name": "Labels"
         },
         "match": {
          "role": "row",
          "text": {
           "regex": "Add dark mode|Typo in docs",
           "flags": "i"
          }
         },
         "count": {
          "eq": 0
         }
        }
       }
      ]
     }
    }
