   "toolCalls": [
    {
     "id": "toolu_01HCuzDe4sAocEKAL8ycgF9S",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-url-status",
        "requirement": "R1",
        "description": "The issue list URL has the status filter set to open.",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/issues",
          "query": {
           "status": {
            "equals": "open",
            "ignoreCase": true
           }
          }
         }
        }
       },
       {
        "id": "r1-no-closed-rows",
        "requirement": "R1",
        "description": "The Issues table contains no cell showing status Closed.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "table",
          "name": "Issues"
         },
         "witness": {
          "role": "columnheader",
          "name": "Status"
         },
         "match": {
          "role": "cell",
          "name": {
           "equals": "Closed",
           "ignoreCase": true
          }
         },
         "count": {
          "eq": 0
         }
        }
       },
       {
        "id": "r2-url-label",
        "requirement": "R2",
        "description": "The issue list URL has the label filter set to bug.",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/issues",
          "query": {
           "label": {
            "equals": "bug",
            "ignoreCase": true
           }
          }
         }
        }
       },
       {
        "id": "r2-no-nonbug-rows",
        "requirement": "R2",
        "description": "The Issues table contains no row whose labels are only feature or only docs.",
        "assert": {
         "kind": "contains",
         "scope": {
          "role": "table",
          "name": "Issues"
         },
         "witness": {
          "role": "columnheader",
          "name": "Labels"
         },
         "match": {
          "role": "cell",
          "name": {
           "regex": "^\\s*(feature|docs)\\s*$",
           "flags": "i"
          }
         },
         "count": {
          "eq": 0
         }
        }
       }
      ]
     }
    }
   ],
