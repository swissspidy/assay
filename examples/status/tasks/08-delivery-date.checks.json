{
  "schema": "assay.checks/v1",
  "id": "tiny-shop/delivery-date",
  "version": "1",
  "task": {
    "instruction": "Place an order for my cart with express shipping and show me the estimated delivery date.",
    "outcomes": "Then the confirmation shows an estimated delivery of 5 November 2026"
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "Estimated delivery shown as 5 November 2026",
      "source": {
        "field": "outcomes",
        "quote": "estimated delivery of 5 November 2026"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The order is for the cart as it was before the task",
      "source": {
        "field": "instruction",
        "quote": "Place an order for my cart"
      }
    }
  ],
  "checks": [
    {
      "id": "C1",
      "requirement": "R1",
      "description": "An order was placed (POST /api/orders → 201).",
      "assert": {
        "kind": "request",
        "match": {
          "method": "POST",
          "url": {
            "path": "/api/orders"
          },
          "status": 201
        }
      }
    },
    {
      "id": "C2",
      "requirement": "R1",
      "description": "The Order summary shows an estimated delivery date of 2026-11-05.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "node",
          "field": "text",
          "target": {
            "role": "paragraph",
            "text": {
              "contains": "Estimated delivery"
            },
            "within": {
              "role": "region",
              "name": "Order summary"
            }
          }
        },
        "normalize": [
          {
            "op": "extract",
            "regex": "Estimated delivery:?\\s*(.+)$"
          },
          {
            "op": "date",
            "locale": "en-GB"
          }
        ],
        "expect": {
          "equals": "2026-11-05"
        }
      }
    },
    {
      "id": "C3",
      "requirement": "R2",
      "description": "An order was placed, and its items (from the server's response) are the items the cart held before the task.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "request",
            "match": {
              "method": "POST",
              "url": {
                "path": "/api/orders"
              },
              "status": 201
            }
          },
          {
            "kind": "value",
            "source": {
              "from": "response",
              "match": {
                "method": "POST",
                "url": {
                  "path": "/api/orders"
                },
                "status": 201
              },
              "pointer": "/items",
              "pick": "last"
            },
            "normalize": [
              {
                "op": "items"
              }
            ],
            "expect": {
              "sameAs": {
                "source": {
                  "from": "probe",
                  "probe": "cart",
                  "pointer": "/items",
                  "at": "before"
                },
                "normalize": [
                  {
                    "op": "items"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "locked": {
    "by": "alice",
    "at": "2026-11-09T09:00:00.000Z",
    "content": "sha256:f2af0307ec4855f8c727043345d9464c8aea4e566411fda89e4c4685dfd17f6e",
