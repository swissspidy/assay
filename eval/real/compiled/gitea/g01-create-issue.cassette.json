                "id": "r1-issue-created-open",
                "requirement": "R1",
                "description": "After the task, the acme/webapp issues include an open issue titled \"Search results ignore accents\" with label bug.",
                "assert": {
                  "kind": "value",
                  "source": {
                    "from": "probe",
                    "probe": "issues"
                  },
                  "expect": {
                    "schema": {
