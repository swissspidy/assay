                    "method": "POST",
                    "url": {
                      "path": "/acme/webapp/issues/new"
                    },
                    "status": {
                      "gte": 200,
                      "lt": 400
                    }
                  }
                }
              },
              {
                "id": "r2-title",
                "requirement": "R2",
                "description": "The issues after the task include one titled exactly \"Search results ignore accents\" with label bug.",
                "assert": {
                  "kind": "value",
                  "source": {
                    "from": "probe",
