                "description": "Before the task, no issue titled \"Search results ignore accents\" existed in acme/webapp, so the issue is new.",
                "assert": {
                  "kind": "value",
                  "source": {
                    "from": "probe",
                    "probe": "issues",
                    "at": "before"
