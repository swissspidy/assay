     "id": "toolu_0118qoSqKc6PmeRckDysCNnq",
     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-repo-issues-path",
        "requirement": "R1",
        "description": "The current page is the issue list of the acme/webapp repository.",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/acme/webapp/issues"
         }
        }
       },
       {
        "id": "r2-state-open",
        "requirement": "R2",
        "description": "The issue list's state filter is open (explicitly or by default with no state parameter).",
        "assert": {
         "kind": "anyOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/acme/webapp/issues",
            "query": {
             "state": {
              "equals": "open"
             }
            }
           }
          },
          {
           "kind": "url",
           "match": {
            "path": "/acme/webapp/issues",
            "query": {
             "state": null
            }
           }
          }
         ]
        }
       },
       {
        "id": "r2-no-closed-rows",
        "requirement": "R2",
        "description": "The closed bug issues 'Session expires too early' and 'Login fails with SSO' are not listed.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "contains",
           "scope": {
            "landmark": {
             "role": "main"
            }
           },
           "witness": {
            "role": "link",
            "name": "New Issue"
           },
           "match": {
            "role": "link",
            "name": {
             "equals": "Session expires too early"
            }
           },
           "count": {
            "eq": 0
           }
          },
          {
           "kind": "contains",
           "scope": {
            "landmark": {
             "role": "main"
            }
           },
           "witness": {
            "role": "link",
            "name": "New Issue"
           },
           "match": {
            "role": "link",
            "name": {
             "equals": "Login fails with SSO"
            }
           },
           "count": {
            "eq": 0
           }
          }
         ]
        }
       },
       {
        "id": "r3-label-filter-bug",
        "requirement": "R3",
        "description": "The issue list is filtered by exactly the bug label (label id 1).",
        "assert": {
         "kind": "url",
         "match": {
          "path": "/acme/webapp/issues",
          "query": {
           "labels": {
            "regex": "^1$"
           }
          }
         }
        }
       },
       {
        "id": "r3-no-nonbug-rows",
        "requirement": "R3",
        "description": "Open non-bug issues such as 'Add CSV export' and 'Rate limit API endpoints' are not listed, while bug issues are.",
        "assert": {
         "kind": "allOf",
         "of": [
          {
           "kind": "contains",
           "scope": {
            "landmark": {
             "role": "main"
            }
           },
           "witness": {
            "role": "link",
            "name": "New Issue"
           },
           "match": {
            "role": "link",
            "name": {
             "equals": "Add CSV export"
            }
           },
           "count": {
            "eq": 0
           }
          },
          {
