             "role": "main"
            }
           },
           "witness": {
            "role": "link",
            "name": "New Issue"
           },
           "match": {
            "role": "link",
            "name": {
             "equals": "Rate limit API endpoints"
            }
           },
           "count": {
            "eq": 0
           }
          },
          {
           "kind": "contains",
           "scope": {
