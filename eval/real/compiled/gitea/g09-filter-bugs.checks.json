{
  "schema": "assay.checks/v1",
  "id": "gitea/g09-filter-bugs",
  "version": "1",
  "task": {
    "instruction": "Show me the open issues in acme/webapp that are labelled bug."
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The issues shown are from the acme/webapp repository.",
      "source": {
        "field": "instruction",
        "quote": "Show me the open issues in acme/webapp"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The issues shown are only open issues.",
      "source": {
        "field": "instruction",
        "quote": "open issues"
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The issues shown are only ones labelled bug.",
      "source": {
        "field": "instruction",
        "quote": "labelled bug"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-repo-issues-url",
      "requirement": "R1",
      "description": "The page is the issues list of the acme/webapp repository.",
      "assert": {
        "kind": "url",
        "match": {
          "path": "/acme/webapp/issues"
        }
      }
    },
    {
      "id": "r1-shows-repo-issues",
      "requirement": "R1",
      "description": "The issues list shows an open bug issue of acme/webapp (Crash when uploading empty file).",
      "assert": {
        "kind": "contains",
        "scope": {
          "role": "main"
        },
        "match": {
          "role": "link",
          "name": "Crash when uploading empty file"
        }
      }
    },
    {
      "id": "r2-state-open",
      "requirement": "R2",
      "description": "The issues list is filtered to open issues (state=open, or the default open state).",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/acme/webapp/issues"
            }
          },
          {
            "kind": "anyOf",
            "of": [
              {
                "kind": "url",
                "match": {
                  "query": {
                    "state": "open"
                  }
                }
              },
              {
                "kind": "url",
                "match": {
                  "query": {
                    "state": null
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "r2-no-closed-issues",
      "requirement": "R2",
      "description": "The closed issues (Session expires too early, Login fails with SSO) are not shown in the list.",
      "assert": {
        "kind": "contains",
        "scope": {
          "role": "main"
        },
        "witness": {
          "role": "link",
          "name": "New Issue"
        },
        "match": {
          "role": "link",
          "name": {
            "regex": "^(Session expires too early|Login fails with SSO)$"
          }
        },
        "count": {
          "eq": 0
        }
      }
    },
    {
      "id": "r3-label-filter",
      "requirement": "R3",
      "description": "The issues list is filtered to only the bug label (labels=1).",
      "assert": {
        "kind": "url",
        "match": {
          "path": "/acme/webapp/issues",
          "query": {
            "labels": {
              "regex": "^1$"
            }
          }
        }
      }
    },
    {
      "id": "r3-no-nonbug-issues",
      "requirement": "R3",
      "description": "No open issue without the bug label is shown in the list.",
      "assert": {
        "kind": "contains",
        "scope": {
          "role": "main"
        },
        "witness": {
          "role": "link",
          "name": "New Issue"
        },
        "match": {
          "role": "link",
          "name": {
            "regex": "^(Add CSV export|Improve onboarding docs|Upgrade to Node 24|Add keyboard shortcuts|Rate limit API endpoints|How do I reset my API token\\?)$"
          }
        },
        "count": {
          "eq": 0
        }
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T21:04:26.524Z"
  }
}
