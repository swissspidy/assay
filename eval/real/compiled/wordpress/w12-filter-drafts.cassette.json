      "checks": [
       {
        "id": "url-draft-filter",
        "requirement": "R1",
        "description": "The page is the WordPress admin posts list filtered to post_status=draft (post type post or unspecified).",
        "assert": {
         "kind": "anyOf",
         "of": [
          {
           "kind": "url",
           "match": {
            "path": "/wp-admin/edit.php",
            "query": {
             "post_status": {
              "equals": "draft"
             },
             "post_type": {
              "equals": "post"
             }
            }
           }
          },
          {
           "kind": "url",
           "match": {
            "path": "/wp-admin/edit.php",
            "query": {
             "post_status": {
              "equals": "draft"
             },
             "post_type": null
            }
           }
          }
         ]
        }
       },
       {
        "id": "rows-are-drafts",
        "requirement": "R1",
        "description": "Every post row in the posts table shows a 'Last Modified' date, which WordPress shows only for drafts.",
        "assert": {
         "kind": "each",
         "scope": {
          "role": "table",
          "landmark": {
           "role": "main"
