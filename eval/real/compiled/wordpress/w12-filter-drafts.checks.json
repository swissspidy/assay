{
  "schema": "assay.checks/v1",
  "id": "wordpress/w12-filter-drafts",
  "version": "1",
  "task": {
    "instruction": "Show me the list of draft posts."
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The list of draft posts is shown to the user.",
      "source": {
        "field": "instruction",
        "quote": "Show me the list of draft posts."
      }
    }
  ],
  "checks": [
    {
      "id": "url-draft-filter",
      "requirement": "R1",
      "description": "The page is the WordPress admin posts list filtered to post_status=draft (post type post or unspecified).",
      "assert": {
        "kind": "anyOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "path": "/wp-admin/edit.php",
              "query": {
                "post_status": {
                  "equals": "draft"
                },
                "post_type": {
                  "equals": "post"
                }
              }
            }
          },
          {
            "kind": "url",
            "match": {
              "path": "/wp-admin/edit.php",
              "query": {
                "post_status": {
                  "equals": "draft"
                },
                "post_type": null
              }
            }
          }
        ]
      }
    },
    {
      "id": "rows-are-drafts",
      "requirement": "R1",
      "description": "Every post row in the posts table shows a 'Last Modified' date, which WordPress shows only for drafts.",
      "assert": {
        "kind": "each",
        "scope": {
          "role": "table",
          "landmark": {
            "role": "main"
          }
        },
        "match": {
          "role": "row",
          "name": {
            "contains": "Quick edit"
          }
        },
        "assert": {
          "kind": "contains",
          "match": {
            "role": "cell",
            "name": {
              "contains": "Last Modified"
            },
            "column": {
              "contains": "Date"
            }
          }
        }
      }
    },
    {
      "id": "draft-posts-listed",
      "requirement": "R1",
      "description": "The posts table lists the three draft posts: Pricing update for teams, Roadmap 2027 and Spring meetup recap.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "contains",
            "scope": {
              "role": "table",
              "landmark": {
                "role": "main"
              }
            },
            "match": {
              "role": "link",
              "name": {
                "equals": "“Pricing update for teams” (Edit)"
              }
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "table",
              "landmark": {
                "role": "main"
              }
            },
            "match": {
              "role": "link",
              "name": {
                "equals": "“Roadmap 2027” (Edit)"
              }
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "table",
              "landmark": {
                "role": "main"
              }
            },
            "match": {
              "role": "link",
              "name": {
                "equals": "“Spring meetup recap” (Edit)"
              }
            }
          }
        ]
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T21:07:40.744Z"
  }
}
