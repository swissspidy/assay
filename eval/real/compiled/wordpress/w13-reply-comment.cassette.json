     "name": "submit_checks",
     "input": {
      "checks": [
       {
        "id": "r1-reply-stored-on-post",
        "requirement": "R1",
        "description": "The backend holds a new comment on the post 'Flaky tests and how to avoid them' (post 6) with the reply text.",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "comments"
         },
         "expect": {
          "schema": {
           "type": "array",
           "contains": {
            "type": "object",
            "properties": {
             "post": {
              "const": 6
             },
             "id": {
              "not": {
               "const": 6
              }
             },
             "content": {
              "type": "string",
              "pattern": "^\\s*Yes, see the network waits section in the docs[.!]?\\s*$"
             }
            },
            "required": [
             "post",
             "id",
             "content"
            ]
           }
          }
         }
        }
       },
       {
        "id": "r1-reply-parent-is-priya",
        "requirement": "R1",
        "description": "The reply was submitted as a reply to Priya's comment (id 6) on post 6, via the admin Reply action or the public reply form.",
        "onMissing": "abstain",
        "assert": {
         "kind": "anyOf",
         "of": [
          {
           "kind": "value",
           "source": {
            "from": "request",
            "match": {
             "method": "POST",
             "url": {
              "path": "/wp-admin/admin-ajax.php"
             },
             "requestBody": {
              "type": "object",
              "properties": {
               "action": {
                "const": "replyto-comment"
               }
              },
              "required": [
               "action"
              ]
             }
            },
            "pick": "last"
           },
           "expect": {
            "schema": {
             "type": "object",
             "properties": {
              "comment_ID": {
               "const": "6"
              },
              "comment_post_ID": {
               "const": "6"
              },
              "content": {
               "type": "string",
               "pattern": "^\\s*Yes, see the network waits section in the docs[.!]?\\s*$"
              }
             },
             "required": [
              "comment_ID",
              "comment_post_ID",
              "content"
             ]
            }
           }
          },
          {
           "kind": "value",
           "source": {
            "from": "request",
            "match": {
             "method": "POST",
             "url": {
              "path": "/wp-comments-post.php"
             }
            },
            "pick": "last"
           },
           "expect": {
            "schema": {
             "type": "object",
             "properties": {
              "comment_parent": {
               "const": "6"
              },
              "comment_post_ID": {
               "const": "6"
              },
              "comment": {
               "type": "string",
               "pattern": "^\\s*Yes, see the network waits section in the docs[.!]?\\s*$"
              }
             },
             "required": [
              "comment_parent",
              "comment_post_ID",
              "comment"
             ]
            }
           }
          }
         ]
        }
       },
       {
        "id": "r2-reply-text",
        "requirement": "R2",
        "description": "The stored reply comment on post 6 reads 'Yes, see the network waits section in the docs.' (allowing trailing punctuation variation and whitespace).",
        "assert": {
         "kind": "value",
         "source": {
          "from": "probe",
          "probe": "comments"
         },
         "normalize": [
          {
           "op": "items",
           "where": {
            "type": "object",
            "properties": {
             "post": {
              "const": 6
             },
             "id": {
              "not": {
               "const": 6
              }
             },
             "content": {
              "type": "string",
              "pattern": "network waits section"
             }
            },
            "required": [
             "post",
             "id",
             "content"
            ]
           },
           "pointer": "/content"
          }
         ],
         "expect": {
          "schema": {
           "type": "array",
           "minItems": 1,
           "items": {
            "type": "string",
            "pattern": "^\\s*Yes, see the network waits section in the docs[.!]?\\s*$"
           }
          }
         }
        }
       }
      ]
     }
    }
