{
  "schema": "assay.checks/v1",
  "id": "prestashop/s04-checkout",
  "version": "1",
  "task": {
    "instruction": "Check out my cart: deliver it to my address called \"My address\" with My carrier, and pay by bank wire."
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The cart is checked out (order placed).",
      "source": {
        "field": "instruction",
        "quote": "Check out my cart"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "Delivery address used is the one named \"My address\".",
      "source": {
        "field": "instruction",
        "quote": "deliver it to my address called \"My address\""
      }
    },
    {
      "id": "R3",
      "kind": "hard",
      "text": "The shipping carrier selected is \"My carrier\".",
      "source": {
        "field": "instruction",
        "quote": "with My carrier"
      }
    },
    {
      "id": "R4",
      "kind": "hard",
      "text": "Payment method is bank wire.",
      "source": {
        "field": "instruction",
        "quote": "pay by bank wire"
      }
    }
  ],
  "checks": [
    {
      "id": "R1-order-with-cart-lines",
      "requirement": "R1",
      "description": "The backend holds an order whose lines are exactly the items that were in the cart before the task (Hummingbird cushion White x1, Mountain fox notebook Ruled x1), not canceled or in payment error.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "orders"
        },
        "expect": {
          "schema": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "lines",
                "state"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "not": {
                    "enum": [
                      "Canceled",
                      "Payment error"
                    ]
                  }
                },
                "lines": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "allOf": [
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "product",
                          "attributes",
                          "quantity"
                        ],
                        "properties": {
                          "product": {
                            "const": "Hummingbird cushion"
                          },
                          "attributes": {
                            "const": "Color - White"
                          },
                          "quantity": {
                            "const": 1
                          }
                        }
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "product",
                          "attributes",
                          "quantity"
                        ],
                        "properties": {
                          "product": {
                            "const": "Mountain fox notebook"
                          },
                          "attributes": {
                            "const": "Paper Type - Ruled"
                          },
                          "quantity": {
                            "const": 1
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
