{
  "schema": "assay.checks/v1",
  "id": "prestashop/s08-mugs-by-price",
  "version": "1",
  "task": {
    "instruction": "Show me the mugs in the shop, cheapest first."
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "The shop's mugs are shown to the user.",
      "source": {
        "field": "instruction",
        "quote": "Show me the mugs in the shop"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "The mugs are sorted by price, lowest first.",
      "source": {
        "field": "instruction",
        "quote": "cheapest first"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-mug-search-view",
      "requirement": "R1",
      "description": "The current page is the shop's search results for 'mug' (or 'mugs').",
      "assert": {
        "kind": "url",
        "match": {
          "path": "/search",
          "query": {
            "s": {
              "regex": "^\\s*mugs?\\s*$",
              "flags": "i"
            }
          }
        }
      }
    },
    {
      "id": "r1-mugs-listed",
      "requirement": "R1",
      "description": "The listed products are all mugs and include the four mug products of the shop.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "each",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "article"
            },
            "count": {
              "gte": 4
            },
            "assert": {
              "kind": "contains",
              "match": {
                "role": "heading",
                "level": 2,
                "name": {
                  "contains": "mug",
                  "ignoreCase": true
                }
              }
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "heading",
              "level": 2,
              "name": "Mug The best is yet to come"
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "heading",
              "level": 2,
              "name": "Mug The adventure begins"
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "heading",
              "level": 2,
              "name": "Mug Today is a good day"
            }
          },
          {
            "kind": "contains",
            "scope": {
              "role": "main"
            },
            "match": {
              "role": "heading",
              "level": 2,
              "name": "Customizable mug"
            }
          }
        ]
      }
    },
    {
      "id": "r2-sorted-price-asc",
      "requirement": "R2",
      "description": "The results are sorted by price ascending: URL order=product.price.asc and the sort control reads 'Price, low to high'.",
      "assert": {
        "kind": "allOf",
        "of": [
          {
            "kind": "url",
            "match": {
              "query": {
                "order": {
                  "equals": "product.price.asc"
                }
              }
            }
          },
          {
            "kind": "state",
            "target": {
              "role": "button",
              "name": {
                "contains": "Sort by"
              }
            },
            "expect": {
              "text": {
                "contains": "Price, low to high"
              }
            }
          }
        ]
      }
    }
  ],
  "compiled": {
    "compiler": "assay/0.1.0",
    "model": "anthropic:claude-opus-5-5@high",
    "modelsUsed": [
      "claude-opus-5-5"
    ],
    "at": "2026-11-05T21:10:46.253Z"
  }
}
