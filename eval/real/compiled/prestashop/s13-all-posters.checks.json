{
  "schema": "assay.checks/v1",
  "id": "prestashop/s13-all-posters",
  "version": "1",
  "task": {
    "instruction": "Add one of each framed poster the shop sells to my cart."
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "hard",
      "text": "Every framed poster the shop sells is in the user's cart.",
      "source": {
        "field": "instruction",
        "quote": "each framed poster the shop sells to my cart"
      }
    },
    {
      "id": "R2",
      "kind": "hard",
      "text": "Each framed poster is added with a quantity of one.",
      "source": {
        "field": "instruction",
        "quote": "Add one of each"
      }
    }
  ],
  "checks": [
    {
      "id": "r1-all-posters-in-cart",
      "requirement": "R1",
      "description": "The cart (backend probe) has a line for each of the three framed posters: The best is yet to come', The adventure begins, and Today is a good day.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/lines"
        },
        "expect": {
          "schema": {
            "type": "array",
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "product": {
                      "const": "The best is yet to come' Framed poster"
                    }
                  },
                  "required": [
                    "product"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "product": {
                      "const": "The adventure begins Framed poster"
                    }
                  },
                  "required": [
                    "product"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "product": {
                      "const": "Today is a good day Framed poster"
                    }
                  },
                  "required": [
                    "product"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "r2-one-line-per-poster",
      "requirement": "R2",
      "description": "The cart's framed-poster lines are exactly one per framed poster in the active catalog (no poster duplicated in a second line).",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/lines"
        },
        "normalize": [
          {
            "op": "items",
            "where": {
              "properties": {
                "product": {
                  "type": "string",
                  "pattern": "Framed poster$"
                }
              },
              "required": [
                "product"
              ],
              "not": {
                "properties": {
                  "product": {
                    "pattern": "^Pack"
                  }
                },
                "required": [
                  "product"
                ]
              }
            },
            "pointer": "/product"
          }
        ],
        "expect": {
          "sameAs": {
            "source": {
              "from": "probe",
              "probe": "catalog"
            },
            "normalize": [
              {
                "op": "items",
                "where": {
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "Framed poster$"
                    },
                    "active": {
                      "const": 1
                    }
                  },
                  "required": [
                    "name",
                    "active"
                  ],
                  "not": {
                    "properties": {
                      "name": {
                        "pattern": "^Pack"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "pointer": "/name"
              }
            ]
          }
        }
      }
    },
    {
      "id": "r2-quantity-one",
      "requirement": "R2",
      "description": "Every framed-poster line in the cart has quantity 1.",
      "assert": {
        "kind": "value",
        "source": {
          "from": "probe",
          "probe": "cart",
          "pointer": "/lines"
        },
        "expect": {
          "schema": {
            "type": "array",
            "items": {
              "if": {
                "type": "object",
                "properties": {
                  "product": {
                    "type": "string",
                    "pattern": "Framed poster$"
                  }
                },
                "required": [
                  "product"
                ],
                "not": {
                  "properties": {
                    "product": {
                      "pattern": "^Pack"
                    }
                  },
                  "required": [
                    "product"
                  ]
                }
              },
              "then": {
                "properties": {
                  "quantity": {
                    "const": 1
                  }
                },
                "required": [
                  "quantity"
                ]
              }
            }
          }
        }
      }
    }
  ],
