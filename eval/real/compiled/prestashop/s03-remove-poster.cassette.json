    "sha256:8023e2d8e400711af2a0424f29a94dc03a05385ee8156f434a129dc1941e45f6": {
      "stop": "tool_use",
      "text": "",
      "toolCalls": [
        {
          "id": "toolu_01F18LpGDV66pW5Znr1F2Wts",
          "name": "submit_checks",
          "input": {
            "checks": [
              {
                "id": "R1-no-poster-in-cart",
                "requirement": "R1",
                "description": "The backend cart no longer contains any line whose product is a poster.",
                "assert": {
                  "kind": "value",
                  "source": {
                    "from": "probe",
                    "probe": "cart",
                    "pointer": "/lines"
                  },
                  "expect": {
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["product"],
                        "properties": {
                          "product": {
                            "type": "string",
                            "not": {
                              "pattern": "(?i)poster"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "id": "R1-no-poster-in-cart-ci",
                "requirement": "R1",
                "description": "No cart line product name contains 'poster' or 'Poster'.",
                "assert": {
                  "kind": "value",
                  "source": {
                    "from": "probe",
                    "probe": "cart",
                    "pointer": "/lines"
                  },
                  "expect": {
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["product"],
                        "properties": {
                          "product": {
                            "type": "string",
                            "not": {
                              "pattern": "[Pp][Oo][Ss][Tt][Ee][Rr]"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "id": "R2-others-kept",
                "requirement": "R2",
                "description": "The cart lines after the task equal the cart lines before the task minus the poster lines (same products, attributes and quantities).",
                "assert": {
                  "kind": "value",
                  "source": {
                    "from": "probe",
                    "probe": "cart",
                    "pointer": "/lines"
                  },
                  "normalize": [
                    {
                      "op": "items"
                    }
                  ],
                  "expect": {
                    "sameAs": {
                      "source": {
                        "from": "probe",
                        "probe": "cart",
                        "pointer": "/lines",
                        "at": "before"
                      },
                      "normalize": [
                        {
                          "op": "items",
                          "where": {
                            "not": {
                              "properties": {
                                "product": {
                                  "pattern": "[Pp][Oo][Ss][Tt][Ee][Rr]"
                                }
                              },
                              "required": ["product"]
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ],
