{
  "name": "@swissspidy/assay",
  "version": "0.1.0",
  "description": "Compiled outcome verification for web agent tasks",
  "keywords": [
    "agents",
    "evaluation",
    "playwright",
    "testing",
    "verification"
  ],
  "homepage": "https://github.com/swissspidy/assay#readme",
  "bugs": "https://github.com/swissspidy/assay/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissspidy/assay.git"
  },
  "bin": {
    "assay": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./playwright": "./dist/playwright/index.js",
    "./compiler": "./dist/compiler/index.js",
    "./stress": "./dist/stress/index.js",
    "./models": "./dist/model/index.js",
    "./ai-sdk": "./dist/model/ai-sdk.js",
    "./eval": "./dist/eval/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsrs -p tsconfig.build.json && node scripts/rewrite-dts-specifiers.ts",
    "prepack": "npm run build",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "playwright test",
    "test:unit": "playwright test tests/unit",
    "test:pack": "node --test --test-reporter=spec tests/pack/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "shop": "node examples/tiny-shop/server.mjs",
    "references": "node scripts/capture-references.ts",
    "compile:examples": "node scripts/compile-examples.ts",
    "stress": "node scripts/stress.ts",
    "eval": "node scripts/eval.ts",
    "eval:real": "node scripts/eval.ts --dataset real",
    "real:collect": "node eval/real/collect.ts",
    "real:compile": "node eval/real/compile.ts",
    "stability": "node scripts/stability.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@anthropic-ai/sdk": "^1.4.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "ai": "^7.0.147",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsrs": "0.20.1-ts7.1.0-beta"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.4.0",
    "@playwright/test": ">=1.49.0",
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
