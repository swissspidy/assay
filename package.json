{
  "name": "assay",
  "version": "0.1.0",
  "description": "Compiled outcome verification for web agent tasks",
  "license": "MIT",
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./playwright": "./dist/playwright/index.js"
  },
  "scripts": {
    "build": "tsrs -p tsconfig.build.json && node scripts/rewrite-dts-specifiers.ts",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "playwright test",
    "test:unit": "playwright test tests/unit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "shop": "node examples/tiny-shop/server.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsrs": "0.20.1-ts7.1.0-beta"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49.0"
  },
  "engines": {
    "node": ">=24"
  }
}
